{
  "name": "arcclaw-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "mvn -f ../arcclaw-app/pom.xml prepare-package openapi-generator:generate -Pts-dto -DskipTests -q",
    "prebuild": "npm run generate",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@lit/context": "^1.1.2",
    "dompurify": "^3.3.3",
    "lit": "^3.2.0",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@web/test-runner": "^0.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
