# =============================================================================
# ArcClaw — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your specific values.
# DO NOT commit the real '.env' file to version control.
#
# Quick-start defaults are provided where possible. Required fields are
# marked with [REQUIRED] — the app will not start without them.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime Profile
# -----------------------------------------------------------------------------
# Quarkus profile: prod | dev | test
QUARKUS_PROFILE=dev


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Directory where ArcClaw stores its SQLite databases and state files.
# Docker:  leave as ./data (volume-mounted at /app/data)
# Windows: use forward slashes or set to C:/Users/<user>/arcclaw-data
ARCCLAW_DATA_DIR=./data


# -----------------------------------------------------------------------------
# HTTP / CORS
# -----------------------------------------------------------------------------
# Allowed CORS origins. Comma-separated for multiple.
ARCCLAW_CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# LLM — Groq (chat model)
# -----------------------------------------------------------------------------
# [REQUIRED] Groq API key. Get one at: https://console.groq.com
# Used for all agent reasoning (coordinator, researcher, coder, debugger, etc.)
GROQ_API_KEY=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
# GROQ_API_KEY=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
# GROQ_API_KEY=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
# GROQ_API_KEY=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
# GROQ_API_KEY=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


# -----------------------------------------------------------------------------
# LLM — Ollama (local, shared by chat + embeddings)
# -----------------------------------------------------------------------------
# Base URL for the local Ollama instance.
# Docker:  http://ollama:11434  (service name on compose network)
# Local:   http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Chat model loaded into Ollama (used only if switching away from Groq).
OLLAMA_MODEL=llama3.2:1b


# ARCCLAW_LLM_PROVIDER=groq   → existing Groq behaviour unchanged
# ARCCLAW_LLM_PROVIDER=ollama → routes to local Ollama
# ARCCLAW_LLM_PROVIDER=openai → routes to OpenAI directly
ARCCLAW_LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# RAG — Embedding Provider (Phase 61)
# -----------------------------------------------------------------------------
# Controls which service generates embedding vectors for document ingestion
# and semantic search. Switch providers by changing EMBED_PROVIDER only —
# no rebuild needed.
#
# Supported providers:
#   ollama  → local, free, private (default)
#   jina    → Jina AI free tier: 1M tokens/month, no credit card required
#             Get free key: https://jina.ai
#   openai  → OpenAI text-embedding-* (paid, ~$0.02/1M tokens)
#
# Groq does NOT support embeddings (inference-only).
# -----------------------------------------------------------------------------

# Active embedding provider: ollama | jina | openai
# EMBED_PROVIDER=ollama

# EMBED_BASE_URL=http://localhost:11434

# Embedding model name.
#   ollama:  nomic-embed-text:v1.5     (768 dims)
#            mxbai-embed-large          (1024 dims)
#   jina:    auto-set to jina-embeddings-v5-text-nano when EMBED_PROVIDER=jina
#   openai:  text-embedding-3-small    (1536 dims)
#            text-embedding-3-large    (3072 dims)
# EMBED_MODEL=nomic-embed-text:v1.5

# Vector dimension — MUST match the model above.
# Mismatch causes silent vec_global insert failures.
#   nomic-embed-text:v1.5   → 768
#   mxbai-embed-large       → 1024
#   jina-embeddings-v5-text-nano      → 1024
#   text-embedding-3-small  → 1536
# EMBED_DIMENSIONS=768

# API key — required for jina and openai, leave blank for ollama.
# EMBED_API_KEY=

# Embedding call timeout in seconds.
# Keep low so a down provider fails fast and degrades gracefully to FTS5-only.
# EMBED_TIMEOUT_SECONDS=10

# --- Switching to Jina AI ---
EMBED_BASE_URL=https://api.jina.ai/v1/
EMBED_PROVIDER=jina
EMBED_API_KEY=jina_dc90af09379b47d191c3e0372bab1adbe-g3Nq6RCH_9YF59SGtgGdDmz8Fg
EMBED_DIMENSIONS=768
EMBED_TIMEOUT_SECONDS=30
# (EMBED_MODEL is ignored — jina-embeddings-v5-text-nano is used automatically)

# --- Switching to OpenAI ---
# EMBED_PROVIDER=openai
# EMBED_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMBED_MODEL=text-embedding-3-small
# EMBED_DIMENSIONS=1536
# EMBED_TIMEOUT_SECONDS=10


# -----------------------------------------------------------------------------
# RAG — sqlite-vec Native Extension
# -----------------------------------------------------------------------------
# Path to the vec0 native binary. No extension suffix — SQLite appends
# .so (Linux), .dll (Windows), .dylib (macOS) automatically.
#
# Download from: https://github.com/asg017/sqlite-vec/releases/tag/v0.1.6
#   Linux / WSL2:  sqlite-vec-v0.1.6-loadable-linux-x86_64.tar.gz → vec0.so
#   Windows:       sqlite-vec-v0.1.6-loadable-windows-x86_64.zip  → vec0.dll
#   macOS:         sqlite-vec-v0.1.6-loadable-macos-aarch64.tar.gz → vec0.dylib
#
# Place the file at ./lib/ and set the path without the file extension:
#   Linux/WSL2:  SQLITE_VEC_PATH=./lib/vec0   (→ ./lib/vec0.so)
#   Windows:     SQLITE_VEC_PATH=./lib/vec0   (→ ./lib/vec0.dll)
#   Docker:      override not needed — Dockerfile.native sets /app/lib/vec0
#
# If missing, vec0 load fails silently and RAG degrades to FTS5-only.
SQLITE_VEC_PATH=./lib/vec0


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# [REQUIRED] Internal API key for admin endpoints (/api/v1/mcp, /api/v1/skills).
# Generate: openssl rand -hex 16
ARCCLAW_API_KEY_INTERNAL=key-internal-cWevfEoRvstUv0PqGpf02LzDY5kPNaz1y9GSl0LZOwU=

# CI/CD API key (read-only, used by pipeline smoke tests).
ARCCLAW_API_KEY_CI=key-ci-JV/qXAikcUoSCCUsqYxLvNjxW/N3KROQtawg3VRFrJs=

# [REQUIRED] HMAC key for the tamper-proof audit event chain.
# Must be stable across restarts and at least 32 bytes.
# Generate: openssl rand -hex 32
ARCCLAW_AUDIT_HMAC_KEY=AUDIT_HMAC_KEY-P3e+42qbAEHmKhpfaB+BitjqNUQemv5CiASFyEvvJHU=

# Secret auto-seeding into agent vault on session start (dev convenience).
# Set false in production — seed secrets manually via /api/v1/vault.
ARCCLAW_AUTO_SEED_SECRETS=true

# GitHub personal access token seeded into agent vault for the github tool.
# Scopes needed: repo (read), gist (read)
GITHUB_TOKEN=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


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Set to true and provide token to enable the Telegram bot interface.
ARCCLAW_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=7688103905:AAGJgrNpplvc4uT_5YKYj-2uxj1UuwTlbdA

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Find your ID: message @userinfobot on Telegram.
ARCCLAW_TELEGRAM_ALLOWED_USER_IDS=945307929

# Comma-separated Telegram usernames (without @) — optional, IDs take priority.
ARCCLAW_TELEGRAM_ALLOWED_USERS=rsrini7


# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# OTLP endpoint for traces. Use local Jaeger or managed provider.
# Docker compose: http://otel-collector:4317
# Local Jaeger:   http://localhost:4317
QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
OTEL_SDK_DISABLED=true


# -----------------------------------------------------------------------------
# Debug / Developer Flags
# -----------------------------------------------------------------------------
# Log full LLM request/response bodies. Do NOT enable in production —
# exposes user data and API keys in plaintext logs.
ARCCLAW_DEBUG_LLM=false


ARCCLAW_VAULT_PEPPER=prod-pepper-0000000000000000000000000000

ARCCLAW_SANDBOX_ENABLED=true

# PII scanning mode: REDACT | BLOCK_AND_NOTIFY | LOG_ONLY
# ARCCLAW_PII_MODE=BLOCK_AND_NOTIFY

JDK_JAVA_OPTIONS="--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -Dsun.misc.unsafe.memory.access=allow -Dquarkus.otel.sdk.disabled=true"