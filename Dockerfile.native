## Native Image build using UBI 9 Minimal mapped with Podman rootless isolation
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.3

# Install Podman and dependencies for rootless storage (shadow-utils for userns)
# Also install glibc for libm.so.6 - required by vec0.so (sqlite-vec) which calls
# sqrtf at runtime. GraalVM native-image does not link libm statically, so it must
# be preloaded via LD_PRELOAD before the process starts.
RUN microdnf update -y && \
    microdnf install -y podman shadow-utils slirp4netns fuse-overlayfs iptables glibc && \
    microdnf clean all

# Create 'amsha' user for rootless podman
RUN useradd -m -s /bin/bash amsha

# Apply the custom containers.conf for vfs storage driver inside the container
COPY containers.conf /etc/containers/containers.conf

# Setup required Subuid/Subgid maps for rootless mode
RUN echo "amsha:100000:65536" > /etc/subuid && \
    echo "amsha:100000:65536" > /etc/subgid

WORKDIR /app

# Create internal mount points and assign ownership before dropping privileges
RUN mkdir -p /home/amsha/.config/containers /home/amsha/.local/share/containers \
             /app/data /app/lib && \
    chown -R amsha:amsha /app /home/amsha

# Switch to standard user
USER amsha

# Copy the Quarkus native binary
COPY app/target/*-runner /app/application

# Copy the sqlite-vec native extension (Linux x86_64 .so only - the .dll and
# .dylib are for Windows/macOS and have no use inside this Linux container)
COPY lib/vec0.so /app/lib/vec0.so

# Ensure execution permission
USER root
RUN chmod +x /app/application && \
    chmod 755 /app/lib/vec0.so
USER amsha

# Preload libm so that dlopen(vec0.so) can resolve sqrtf and other math symbols.
# GraalVM native-image statically links only reachable Java code - libm is excluded.
# Without LD_PRELOAD, SQLite's load_extension('vec0') fails with:
#   undefined symbol: sqrtf
# Vector search degrades silently to FTS5-only without this line.
ENV LD_PRELOAD=/lib64/libm.so.6

# Absolute path to the vec0 extension - no extension suffix needed, SQLite
# appends .so automatically on Linux.
# Must be absolute so it resolves correctly regardless of working directory.
ENV AMSHA_RAG_VEC_PATH=/app/lib/vec0

EXPOSE 8080

CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]