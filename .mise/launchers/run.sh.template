#!/usr/bin/env bash
# run.sh - ArcClaw launcher with first-run auto-setup
# Usage: ./run.sh serve | chat | attach | ask "your goal"
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
EXE="$SCRIPT_DIR/arcclaw-app-1.0.0-SNAPSHOT-runner"

if [[ ! -f "$EXE" ]]; then echo "X  Binary not found: $EXE"; exit 1; fi

# ── First-run auto-setup ───────────────────────────────────────────────────────
if [[ ! -f "$SCRIPT_DIR/.env" ]]; then
    echo -e "\n  -- ArcClaw first-run setup --------------------------------------------------"
    echo "  No .env found -- running interactive setup now."
    echo ""

    [[ -f "$SCRIPT_DIR/.env.example" ]] && cp "$SCRIPT_DIR/.env.example" "$SCRIPT_DIR/.env" || touch "$SCRIPT_DIR/.env"

    _setsed() {
        if grep -q "^$1=" "$SCRIPT_DIR/.env"; then
            sed -i.bak "s|^$1=.*|$1=$2|" "$SCRIPT_DIR/.env" && rm -f "$SCRIPT_DIR/.env.bak"
        else echo "$1=$2" >> "$SCRIPT_DIR/.env"; fi
    }
    _clearkey() { sed -i.bak "s|^$1=.*|# $1=|" "$SCRIPT_DIR/.env" && rm -f "$SCRIPT_DIR/.env.bak"; }

    _VAULT_PEPPER="$(openssl rand -base64 32)"
    _AUDIT_KEY="$(openssl rand -base64 32)"
    _setsed ARCCLAW_VAULT_PEPPER     "$_VAULT_PEPPER"
    _setsed ARCCLAW_AUDIT_HMAC_KEY   "$_AUDIT_KEY"
    _setsed ARCCLAW_API_KEYS_INTERNAL "$(openssl rand -base64 32)"
    _setsed ARCCLAW_API_KEYS_CI       "$(openssl rand -base64 32)"

    cat > "$SCRIPT_DIR/keys-backup.txt" << KEYS
# ArcClaw -- auto-generated secret keys
# Created: $(date)
#
# WARNING: VAULT_PEPPER and AUDIT_HMAC_KEY are immutable.
# Changing them after first boot corrupts your vault and audit log.
# Store somewhere safe (password manager, encrypted backup).
#
ARCCLAW_VAULT_PEPPER=$_VAULT_PEPPER
ARCCLAW_AUDIT_HMAC_KEY=$_AUDIT_KEY
KEYS

    echo "  OK  Auto-generated: VAULT_PEPPER - AUDIT_HMAC_KEY - API_KEY_INTERNAL - API_KEY_CI"
    echo "  !!  Saved to keys-backup.txt -- VAULT_PEPPER is immutable, back it up"
    echo ""

    printf "  ARCCLAW_LLM_PROVIDER (groq, openrouter, openai, ollama) [Default: openrouter]: "
    read -r _PROVIDER
    _PROVIDER=${_PROVIDER:-openrouter}
    _setsed ARCCLAW_LLM_PROVIDER "$_PROVIDER"

    if [[ "$_PROVIDER" == "groq" ]]; then
        while true; do
            printf "  GROQ API KEY (starts with gsk_): "
            read -r _KEY
            [[ "$_KEY" == gsk_* ]] && break
            echo "  X  Must start with gsk_"
        done
        _setsed ARCCLAW_LLM_API_KEY "$_KEY"
    # run.sh.template — openrouter branch:
    elif [[ "$_PROVIDER" == "openrouter" ]]; then
        while true; do
            printf "  OPENROUTER API KEY (starts with sk-or-): "
            read -r _KEY
            [[ "$_KEY" == sk-or-* ]] && break
            echo "  X  Must start with sk-or-"
        done
        _setsed ARCCLAW_LLM_API_KEY     "$_KEY"
        _setsed ARCCLAW_LLM_BASE_URL    "https://openrouter.ai/api/v1"
        # ── NEW: fix model IDs for OpenRouter format ──────────────────────────────
        _setsed ARCCLAW_LLM_MODEL_NAME              "openrouter/free"
        _setsed ARCCLAW_INTENT_CLASSIFIER_MODEL     "meta-llama/llama-3.1-8b-instruct:free"
        _setsed ARCCLAW_COMPACTION_MODEL            "meta-llama/llama-3.1-8b-instruct:free"
        _setsed ARCCLAW_COMPACTION_BASE_URL         "https://openrouter.ai/api/v1"
    elif [[ "$_PROVIDER" == "openai" ]]; then
        printf "  OPENAI API KEY (starts with sk-): "
        read -r _KEY
        _setsed ARCCLAW_LLM_API_KEY "$_KEY"
    elif [[ "$_PROVIDER" == "ollama" ]]; then
        echo "  i  Ollama selected. No API key needed. Ensure it is running on localhost:11434"
        _setsed ARCCLAW_LLM_BASE_URL "http://localhost:11434/v1"
    fi
    echo "  OK  LLM Provider configured as $_PROVIDER."
    echo ""

    printf "  ARCCLAW_EMBED_API_KEY (starts with jina_): "
    read -r _EMBED_KEY
    _setsed ARCCLAW_EMBED_API_KEY "$_EMBED_KEY"
    echo "  OK  ARCCLAW_EMBED_API_KEY set."
    echo ""

    printf "  GITHUB_TOKEN  (optional -- press Enter to skip): "
    read -r _GH_TOKEN
    if [[ -n "$_GH_TOKEN" ]]; then _setsed GITHUB_TOKEN "$_GH_TOKEN"; echo "  OK  GITHUB_TOKEN set."
    else _clearkey GITHUB_TOKEN; echo "  i   GITHUB_TOKEN skipped."; fi
    echo ""

    _TG_ENABLED="$(grep '^ARCCLAW_TELEGRAM_ENABLED=' "$SCRIPT_DIR/.env" 2>/dev/null | tail -1 | cut -d= -f2 | tr -d '[:space:]' || echo 'false')"
    _CMD="${1:-serve}"
    _setup_telegram() {
        printf "  TELEGRAM_BOT_TOKEN  (@BotFather -> /newbot): "
        read -r _TG_TOKEN; _setsed TELEGRAM_BOT_TOKEN "$_TG_TOKEN"; echo "  OK  TELEGRAM_BOT_TOKEN set."
        while true; do
            printf "  ARCCLAW_TELEGRAM_ALLOWED_USER_IDS  (numeric IDs, comma-separated): "
            read -r _TG_IDS_RAW; _TG_IDS="$(echo "$_TG_IDS_RAW" | tr -d ' ')"
            [[ "$_TG_IDS" =~ ^[0-9]+(,[0-9]+)*$ ]] && break
            echo "  X  Numeric only, e.g. 123456789"
        done
        _setsed ARCCLAW_TELEGRAM_ALLOWED_USER_IDS "$_TG_IDS"; echo "  OK  ARCCLAW_TELEGRAM_ALLOWED_USER_IDS set."
        while true; do
            printf "  ARCCLAW_TELEGRAM_ALLOWED_USERS  (usernames without @, comma-separated): "
            read -r _TG_USERS_RAW; _TG_USERS="$(echo "$_TG_USERS_RAW" | tr -d ' ')"
            [[ "$_TG_USERS" =~ ^[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*$ ]] && break
            echo "  X  Letters, numbers and _ only"
        done
        _setsed ARCCLAW_TELEGRAM_ALLOWED_USERS "$_TG_USERS"; echo "  OK  ARCCLAW_TELEGRAM_ALLOWED_USERS set."
        echo ""
    }

    if [[ "$_CMD" == "attach" ]]; then
        _setsed ARCCLAW_TELEGRAM_ENABLED true
        echo -e "\n  attach mode -- Telegram configuration required."
        _setup_telegram
    elif [[ "$_TG_ENABLED" == "true" ]]; then
        echo -e "\n  Telegram is enabled in .env.example."
        printf "  TELEGRAM_BOT_TOKEN  (Enter to skip and disable Telegram): "
        read -r _TG_TOKEN_PEEK
        if [[ -z "$_TG_TOKEN_PEEK" ]]; then
            _setsed ARCCLAW_TELEGRAM_ENABLED false
            _clearkey TELEGRAM_BOT_TOKEN; _clearkey ARCCLAW_TELEGRAM_ALLOWED_USER_IDS; _clearkey ARCCLAW_TELEGRAM_ALLOWED_USERS
            echo -e "  i   Telegram disabled. Re-run ./run.sh attach to configure later.\n"
        else
            _setsed TELEGRAM_BOT_TOKEN "$_TG_TOKEN_PEEK"; echo "  OK  TELEGRAM_BOT_TOKEN set."
            while true; do
                printf "  ARCCLAW_TELEGRAM_ALLOWED_USER_IDS  (numeric IDs, comma-separated): "
                read -r _TG_IDS_RAW; _TG_IDS="$(echo "$_TG_IDS_RAW" | tr -d ' ')"
                [[ "$_TG_IDS" =~ ^[0-9]+(,[0-9]+)*$ ]] && break; echo "  X  Numeric only"
            done
            _setsed ARCCLAW_TELEGRAM_ALLOWED_USER_IDS "$_TG_IDS"; echo "  OK  ARCCLAW_TELEGRAM_ALLOWED_USER_IDS set."
            while true; do
                printf "  ARCCLAW_TELEGRAM_ALLOWED_USERS  (usernames without @, comma-separated): "
                read -r _TG_USERS_RAW; _TG_USERS="$(echo "$_TG_USERS_RAW" | tr -d ' ')"
                [[ "$_TG_USERS" =~ ^[A-Za-z0-9_]+(,[A-Za-z0-9_]+)*$ ]] && break; echo "  X  Letters, numbers and _ only"
            done
            _setsed ARCCLAW_TELEGRAM_ALLOWED_USERS "$_TG_USERS"; echo -e "  OK  ARCCLAW_TELEGRAM_ALLOWED_USERS set.\n"
        fi
    else
        _clearkey TELEGRAM_BOT_TOKEN; _clearkey ARCCLAW_TELEGRAM_ALLOWED_USER_IDS; _clearkey ARCCLAW_TELEGRAM_ALLOWED_USERS
        echo -e "  i   Telegram not enabled -- placeholders cleared.\n"
    fi

    echo -e "  OK  Setup complete. Starting ArcClaw...\n"
fi

# ── Load .env safely (strips Windows carriage returns for cross-platform safety)
if [[ -f "$SCRIPT_DIR/.env" ]]; then
    while IFS= read -r _line || [[ -n "$_line" ]]; do
        _line="${_line//$'\r'/}"
        [[ "$_line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${_line// }" ]] && continue
        if [[ "$_line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*) ]]; then
            export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
        fi
    done < "$SCRIPT_DIR/.env"
fi

export ARCCLAW_SQLITE_VEC_PATH="${ARCCLAW_SQLITE_VEC_PATH:-./lib/vec0}"
export ARCCLAW_DATA_DIR="${ARCCLAW_DATA_DIR:-./data}"
[[ "$(uname -s)" == "Linux" ]] && export LD_PRELOAD=/lib/x86_64-linux-gnu/libm.so.6

if [[ $# -eq 0 ]]; then
    echo ""
    echo "    ___                ________  "
    echo "   /   |  __________  / ____/ /___ __      __"
    echo "  / /| | / ___/ ___/ / /   / / __  / | /| / /"
    echo " / ___ |/ /  / /__  / /___/ / /_/ /| |/ |/ / "
    echo "/_/  |_/_/   \___/  \____/_/\__,_/ |__/|__/  "
    echo ""
    echo "  ArcClaw Agent Kernel"
    echo ""
    echo "  USAGE"
    echo "    ./run.sh serve                   Start HTTP + MCP server on :8080"
    echo "    ./run.sh chat                    Start interactive REPL"
    echo "    ./run.sh ask 'your goal here'    Run one-shot task and exit"
    echo "    ./run.sh attach                  Start Telegram daemon"
    echo ""
    echo "  OPTIONS (append to any command)"
    echo "    --role coordinator|researcher|architect|synthesizer|debugger"
    echo ""
    exit 0
fi
exec "$EXE" "$@"
