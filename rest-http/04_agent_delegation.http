# ─────────────────────────────────────────────────────────────────
# SECTION E - ROLE-CAPABILITY ENFORCEMENT
# ONLY coordinator holds DELEGATE_TO_AGENT in its capability set.
# Any other role attempting it gets 403 ROLE_CAPABILITY_MISMATCH
# from ToolRegistry before the tool's execute() is even called.
# ─────────────────────────────────────────────────────────────────

### [DEL-25] Create session for role-capability tests
# @name capSession
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

###

### [DEL-26] Coder (Brahma) CANNOT use garuda - empty schema + 403
# Brahma has an empty tool schema (no tools at the LangChain4j binding level).
# Even if the LLM attempts the call, ToolRegistry would block with 403.
# Expect 200: agent explains the tool is not available to it.
# Audit: TOOL_BLOCKED event (NOT TOOL_INVOKED) for this session.
POST {{baseUrl}}/api/v1/sessions/{{capSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Use the garuda tool with agent='shiva' and goal='debug the NPE in line 42'.",
    "agentRole": "coder",
    "maxIterations": 3
}

###

### [DEL-27] Debugger (Shiva) CANNOT use garuda - has github but NOT delegate
# Shiva's schema has github only. Attempting garuda gets 403.
# Audit: TOOL_BLOCKED for this session.
POST {{baseUrl}}/api/v1/sessions/{{capSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Use the garuda tool with agent='brahma' and goal='write the fix code'.",
    "agentRole": "debugger",
    "maxIterations": 3
}

###

### [DEL-28] Researcher (Saraswati) CANNOT use garuda - 403
# Audit: TOOL_BLOCKED for this session.
POST {{baseUrl}}/api/v1/sessions/{{capSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Use the garuda tool with agent='brihaspati' and goal='design the service layer'.",
    "agentRole": "researcher",
    "maxIterations": 3
}

###

### [DEL-29] Architect (Brihaspati) CANNOT use garuda - 403
# Audit: TOOL_BLOCKED for this session.
POST {{baseUrl}}/api/v1/sessions/{{capSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Use the garuda tool with agent='shiva' and goal='find the bug'.",
    "agentRole": "architect",
    "maxIterations": 3
}

###

### [DEL-29a] Verify TOOL_BLOCKED in audit for all above - NO TOOL_INVOKED for garuda
# Expect: TOOL_BLOCKED events with reasonCode=ROLE_CAPABILITY_MISMATCH.
# Confirm: zero TOOL_INVOKED(garuda) events in this session.
GET {{baseUrl}}/api/v1/audit/session/{{capSession.response.body.sessionId}}
X-ArcClaw-API-Key: {{validKey}}

###

DELETE {{baseUrl}}/api/v1/sessions/{{capSession.response.body.sessionId}}
X-ArcClaw-API-Key: {{validKey}}

###

# ─────────────────────────────────────────────────────────────────
# SECTION F - GITHUB MISUSE GUARD (ToolStepHandler Phase 76 fix)
# Coordinator CAN legitimately call github when a real GitHub resource
# is present in the goal or args (owner/repo, github.com URL).
# Without a resource, ToolStepHandler returns retryEngine directive
# to redirect the coordinator via garuda or FINISH.
# ─────────────────────────────────────────────────────────────────

### [DEL-30] Create coordinator session for GitHub guard tests
# @name ghGuardSession
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

###

### [DEL-31] GitHub guard BLOCKS: no GitHub resource in goal
# Coordinator has github in schema but goal has no repo/URL reference.
# Expect 200: ToolStepHandler retryEngine fires, coordinator redirects
# or uses FINISH. Logs: "goal contains no GitHub repository or resource".
POST {{baseUrl}}/api/v1/sessions/{{ghGuardSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Look up whether Java records support inheritance.",
    "agentRole": "coordinator",
    "maxIterations": 4
}

###

