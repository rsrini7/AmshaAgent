POST {{baseUrl}}/api/v1/sessions/{{intentSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Delegate to saraswati: research the CAP theorem and explain which guarantees SQLite provides in WAL mode.",
