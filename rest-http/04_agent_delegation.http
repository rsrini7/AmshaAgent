POST {{baseUrl}}/api/v1/sessions/{{ghGuardSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Give me the gist of how Quarkus CDI scopes work.",
    "agentRole": "coordinator",
    "maxIterations": 3
}

