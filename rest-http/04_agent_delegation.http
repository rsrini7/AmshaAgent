# ─────────────────────────────────────────────────────────────────
# SECTION G - INNER SESSION CHECKPOINT ISOLATION
# Each delegation creates a checkpoint row keyed on:
#   (innerSessionId, agentRole) where innerSessionId = outer + ":d:" + role + ":" + uuid
# These inner rows must be separate from the outer coordinator row.
# ─────────────────────────────────────────────────────────────────

### [DEL-35] Create coordinator session for isolation test
# @name isoSession
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

###

### [DEL-36] Delegate to brahma - triggers inner coder checkpoint row
# Expect 200 Finished: Brahma's answer in coordinator response.
# Post-check: outer coordinator session status = COMPLETED.
# Inner session row exists under {outerSessionId}:d:coder:{uuid} key.
POST {{baseUrl}}/api/v1/sessions/{{isoSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Delegate to brahma: write a Java method isPrime(int n) that returns true if n is a prime number.",
    "agentRole": "coordinator",
    "maxIterations": 5
}

###

### [DEL-37] Check outer coordinator session status - must be COMPLETED
# Inner session row must NOT overwrite or merge with this outer row.
# Expect: status=COMPLETED, agentRole=coordinator.
GET {{baseUrl}}/api/v1/sessions/{{isoSession.response.body.sessionId}}/status
X-ArcClaw-API-Key: {{validKey}}

###

### [DEL-38] Check outer coordinator audit - must contain TOOL_INVOKED(garuda)
# Must NOT contain sandboxexec or inner-agent tool events (those are inner session).
