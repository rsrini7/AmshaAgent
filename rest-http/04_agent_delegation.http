# Logs: no guard redirect, github tool call attempted.
POST {{baseUrl}}/api/v1/sessions/{{ghGuardSession.response.body.sessionId}}/run-async
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
    "goal": "Check the rsrini7/mermaid2gif repository for its latest commit message.",
    "agentRole": "coordinator",
    "maxIterations": 4
}

###

