###

# ─────────────────────────────────────────────────────────────────
# GITHUB COMMANDS (handled by CommandDispatchHandler → agent tools)
# These are NOT zero-token reflexes but command-dispatch patterns.
# ─────────────────────────────────────────────────────────────────

### [GITHUB-1] /github list repos
# Expect: lists GitHub repos (requires GITHUB_TOKEN in vault).
POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/github list rsrini7 repos",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

### [GITHUB-2] /github view README
# Expect: fetches README from specified repo.
POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/github view rsrini7/AmshaAgent readme",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

# ─────────────────────────────────────────────────────────────────
# CLEANUP
# ─────────────────────────────────────────────────────────────────

DELETE {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}
X-Amsha-API-Key: {{validKey}}

