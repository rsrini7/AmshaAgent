POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/reflex",
    "agentRole": "coordinator",
    "maxIterations": 1
}

