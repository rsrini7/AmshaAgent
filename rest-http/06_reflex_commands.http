POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/commands",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

### [REFLEX-23] /help - help text (alias for /reflex)
POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/help",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

# ─────────────────────────────────────────────────────────────────
# BULK DELETE CRON - deletecron all (DeleteCronReflex)
# ─────────────────────────────────────────────────────────────────

### [REFLEX-24] deletecron all - bulk delete all cron jobs
# Expect: "All %d cron jobs deleted" or "No cron jobs found" (zero-token).
POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "deletecron all",
    "agentRole": "coordinator",
    "maxIterations": 1
