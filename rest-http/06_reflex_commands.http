POST {{baseUrl}}/api/v1/sessions/{{reflexSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/resume 1",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

# ─────────────────────────────────────────────────────────────────
# /REFLEX, /COMMANDS, /HELP - list registered reflexes (ListReflexesReflex)
