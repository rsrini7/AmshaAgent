POST {{baseUrl}}/api/v1/sessions/{{pruneSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{"goal": "Memory window test message 9: What is Apache Camel?", "agentRole": "coordinator", "maxIterations": 1}

