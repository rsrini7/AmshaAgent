POST {{baseUrl}}/api/v1/sessions/{{pruneSession.response.body.sessionId}}/run
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{"goal": "Memory window test message 10: What is a CDI scope?", "agentRole": "coordinator", "maxIterations": 1}

