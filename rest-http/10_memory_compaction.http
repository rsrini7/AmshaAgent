# ─────────────────────────────────────────────────────────────────
# CONTEXT COMPACTION - VERIFICATION
# After compaction runs, the summary is searchable via MemorySearchTool
# ─────────────────────────────────────────────────────────────────

### [COMPACT-0] Create session for compaction test
# @name compactSession
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

###

### [COMPACT-1] Search memory after compaction has run in pruneSession
# MemorySearchTool is scoped to userId - it searches across all sessions for this user.
# Expect: results referencing topics from the pruned messages above (if same user).
POST {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Search your memory for any previous discussions about Argon2id or AES-GCM-SIV.",
    "agentRole": "researcher",
    "maxIterations": 2
}


###

GET {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}/status/researcher
X-Amsha-API-Key: {{validKey}}


###


POST {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}/run-async
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "/approve",
    "agentRole": "researcher",
    "maxIterations": 1
}

###

### [COMPACT-2] Non-ASCII memory search (Phase 64-A A3 fix)
# Before Phase 64-A: non-ASCII queries silently returned empty.
# After fix: only FTS5 syntax chars are escaped, Unicode passes through.
# First seed some content in a different language, then search for it.
POST {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Explain this: 機械学習 (machine learning) is a subset of 人工知能 (AI).",
    "agentRole": "researcher",
    "maxIterations": 1
}

###

POST {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Search memory for 機械学習.",
    "agentRole": "researcher",
    "maxIterations": 2
}

###

### [COMPACT-3] Codepoint-safe truncation (Phase 64-D1)
# After Phase 64-D1, summaries with emoji or supplementary Unicode chars
# are truncated at codepoint boundaries - no mid-surrogate-pair slicing.
# Send content with emoji that would be in a long compaction summary.
POST {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Summarise the following 🤖 AI topics: deep learning 🧠, neural networks 🔬, transformers ⚡, embeddings 📊, and RAG 🗂️ retrieval-augmented generation for enterprise Java.",
    "agentRole": "researcher",
    "maxIterations": 1
}

###

DELETE {{baseUrl}}/api/v1/sessions/{{compactSession.response.body.sessionId}}
X-Amsha-API-Key: {{validKey}}

###


# ─────────────────────────────────────────────────────────────────
# CROSS-SESSION MEMORY ISOLATION
# Each user's compaction summaries are scoped to their userId.
# A different user must not see another user's memory.
# ─────────────────────────────────────────────────────────────────

### [ISOLATION-1] Session A - establish unique fact
# @name isoSessionA
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

###

POST {{baseUrl}}/api/v1/sessions/{{isoSessionA.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Remember this unique fact: the secret code is AMSHA-ISOLATION-TEST-ALPHA.",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

### [ISOLATION-2] Session B - try to retrieve Session A's fact
# @name isoSessionB
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

###

### Session B must NOT see Session A's secret code.
### MemorySearchTool is userId-scoped - returns only the caller's compaction summaries.
POST {{baseUrl}}/api/v1/sessions/{{isoSessionB.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Search memory for AMSHA-ISOLATION-TEST-ALPHA.",
    "agentRole": "coordinator",
    "maxIterations": 2
}

###

DELETE {{baseUrl}}/api/v1/sessions/{{isoSessionA.response.body.sessionId}}
X-Amsha-API-Key: {{validKey}}

###

DELETE {{baseUrl}}/api/v1/sessions/{{isoSessionB.response.body.sessionId}}
X-Amsha-API-Key: {{validKey}}

###

