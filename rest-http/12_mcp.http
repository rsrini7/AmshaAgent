### ═══════════════════════════════════════════════════════════════
###

@adminBase = http://localhost:8080/api/v1
@mcpBase   = http://localhost:8080
@validKey  = key-internal-cWevfEoRvstUv0PqGpf02LzDY5kPNaz1y9GSl0LZOwU=
###
# Expect 200: {"serverEnabled":true,"dynamicToolCount":0}
# If 404 → arcclaw.mcp.server-enabled=false in your config
# dynamicToolCount grows after FLOW D connect calls
GET {{adminBase}}/mcp/status
Accept: application/json
X-ArcClaw-API-Key: {{validKey}}
###
# Expect 200:
# {
#   "exposedInternalTools": [
#     {"name":"github",        "description":"...","inputSchema":"{...}"},
#     {"name":"memory_search", "description":"...","inputSchema":"{...}"}
#   ],
#   "registeredDynamicTools": []   ← empty until FLOW D runs
# }
GET {{adminBase}}/mcp/tools
Accept: application/json
X-ArcClaw-API-Key: {{validKey}}
###
# Expect 200: JSON-RPC result containing protocolVersion + capabilities
# The Mcp-Session-Id response header is captured into {{mcpSessionId}}.
# Body may be prefixed with "data: " (SSE envelope) — both formats are valid.
POST {{mcpBase}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
X-ArcClaw-API-Key: {{validKey}}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": {
      "name": "http-client-test",
      "version": "1.0"
    }
  }
}

> {%
client.global.set("mcpSessionId", response.headers.valuesOf("Mcp-Session-Id")[0]);
client.test("MCP initialize returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("Mcp-Session-Id header captured", function() {
  client.assert(
    client.global.get("mcpSessionId") !== undefined &&
    client.global.get("mcpSessionId") !== "",
    "Mcp-Session-Id header missing — all subsequent calls will fail"
  );
});
client.test("protocolVersion in response", function() {
  var body = response.body;
  var json = body.startsWith("data:") ? body.substring(5).trim() : body;
  client.assert(json.includes("protocolVersion"), "protocolVersion missing");
});
%}
###
# Expect 202: empty body (notification — no JSON-RPC response per spec)
# MUST be sent before tools/list or tools/call
POST {{mcpBase}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
X-ArcClaw-API-Key: {{validKey}}
Mcp-Session-Id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "method": "notifications/initialized",
  "params": {}
}

> {%
client.test("notifications/initialized returns 202", function() {
  client.assert(response.status === 202, "Expected 202, got " + response.status);
});
%}
###
# Expect 200: tools array containing "github" and "memory_search"
POST {{mcpBase}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
X-ArcClaw-API-Key: {{validKey}}
Mcp-Session-Id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

> {%
client.test("tools/list returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("github tool present", function() {
  var body = response.body;
  var json = body.startsWith("data:") ? body.substring(5).trim() : body;
  client.assert(json.includes('"github"'), "github missing from tools/list");
});
client.test("memory_search tool present", function() {
  var body = response.body;
  var json = body.startsWith("data:") ? body.substring(5).trim() : body;
  client.assert(json.includes('"memory_search"'), "memory_search missing from tools/list");
});
%}
###
# Expect 200: result.content[0].text = actual memory search output
# Flow: McpToolsBean.memorySearch() → McpToolBridge.invoke()
#       → ToolRegistry.invokeTool() → memory search impl
# Audit event MCP_TOOL_INVOKED is persisted for every tool call
POST {{mcpBase}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
X-ArcClaw-API-Key: {{validKey}}
Mcp-Session-Id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "memory_search",
    "arguments": {
      "query": "ArcClaw architecture overview"
    }
  }
}

> {%
client.test("tools/call memory_search returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("result contains content block", function() {
  var body = response.body;
  var json = body.startsWith("data:") ? body.substring(5).trim() : body;
  client.assert(json.includes('"content"'), "content block missing");
});
%}
###
