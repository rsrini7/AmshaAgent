  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
%}
###
# Expect 200 HTTP with JSON-RPC error body (errors are HTTP 200 per JSON-RPC spec)
# McpToolBridge throws McpToolNotAllowedException →
# {"jsonrpc":"2.0","id":5,"error":{"code":...,"message":"Tool 'sandbox_exec' not in allowlist"}}
POST {{mcpBase}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
X-ArcClaw-API-Key: {{validKey}}
Mcp-Session-Id: {{mcpSessionId}}

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "sandbox_exec",
    "arguments": {}
  }
}
###
# Quarkiverse MCP session validation rejects missing Mcp-Session-Id
POST {{mcpBase}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
X-ArcClaw-API-Key: {{validKey}}

{
  "jsonrpc": "2.0",
  "id": 6,
  "method": "tools/list",
  "params": {}
}
###
# Expect 200: {"name":"self","url":"...","toolsRegistered":2,"status":"connected"}
# Proves the full outbound client stack:
#   McpConnectResource → McpClientService.connect() →
#   MCP initialize handshake → tools/list → DynamicToolCapabilityRegistry.register()
POST {{adminBase}}/mcp/connect
Content-Type: application/json
X-ArcClaw-API-Key: {{validKey}}

{
  "name": "self",
  "url": "http://localhost:8080/mcp"
}

> {%
client.test("self-connect returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("status is connected", function() {
  client.assert(response.body.includes('"connected"'), "status not connected");
});
client.test("tools registered", function() {
  client.assert(response.body.includes('"toolsRegistered"'), "toolsRegistered field missing");
});
%}
