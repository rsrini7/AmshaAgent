GET {{adminBase}}/mcp/connect
Accept: application/json
X-ArcClaw-API-Key: {{validKey}}
###
# After connecting, the agent can invoke its tools naturally via Telegram.
# The LLM selects them when relevant — same as built-in tools.
# POST {{adminBase}}/mcp/connect
# Content-Type: application/json
# X-ArcClaw-API-Key: {{validKey}}
#
# {
#   "name": "remote",
#   "url": "http://your-mcp-server:3000/mcp"
# }
###
# Expect 200: {"name":"self","deregistered":true,"toolsRemoved":2}
# After this: MCP-ADMIN-2 shows registeredDynamicTools:[]
# /mcp in Telegram → "Dynamic MCP tools: none connected"
DELETE {{adminBase}}/mcp/connect/self
Accept: application/json
X-ArcClaw-API-Key: {{validKey}}

> {%
client.test("disconnect returns 200", function() {
  client.assert(response.status === 200, "Expected 200, got " + response.status);
});
client.test("toolsRemoved present", function() {
  client.assert(response.body.includes('"toolsRemoved"'), "toolsRemoved missing");
});
%}
