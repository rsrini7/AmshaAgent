### [D-SMOKE-1] D1: Compaction with emoji/CJK content - no garbled output
# @name dSmokeSession
POST {{baseUrl}}/api/v1/sessions
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

###

POST {{baseUrl}}/api/v1/sessions/{{dSmokeSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Discuss these topics: 日本語 (Japanese NLP) 🤖 AI tools, 한국어 (Korean ML), and ＡＩ（人工知能）in enterprise Java.",
    "agentRole": "researcher",
    "maxIterations": 1
}

###

### [D-SMOKE-2] D5: Single-pass esc() - all 18 special chars escaped correctly
# If esc() had a bug (missed a char, double-escaped), the Telegram message
# would fail to send or render incorrectly. Via REST: confirm agent responds
# to a message containing MarkdownV2 special chars without error.
POST {{baseUrl}}/api/v1/sessions/{{dSmokeSession.response.body.sessionId}}/run
Content-Type: application/json
X-Amsha-API-Key: {{validKey}}

{
    "goal": "Explain the following: user_name.field, (method), [array], *pointer, and the ~tilde~ operator.",
    "agentRole": "coordinator",
    "maxIterations": 1
}

###

### [D-SMOKE-3] D7: SANDBOX_EXEC removed - calling it via MCP must return error
# After D7 cleanup, SANDBOX_EXEC is no longer in the ToolCapability enum.
# Any skill YAML or MCP tool referencing "sandboxexec" will be rejected.
# Test via MCP tools/call - expect error about unknown tool.
# (Only if MCP server is running - skip if not using MCP)
# POST {{baseUrl}}/mcp
# Content-Type: application/json
# Accept: application/json, text/event-stream
# X-Amsha-API-Key: {{validKey}}
# {
#   "jsonrpc": "2.0",
#   "id": 99,
#   "method": "tools/call",
#   "params": {"name": "sandbox_exec", "arguments": {}}
# }

###

DELETE {{baseUrl}}/api/v1/sessions/{{dSmokeSession.response.body.sessionId}}
X-Amsha-API-Key: {{validKey}}

