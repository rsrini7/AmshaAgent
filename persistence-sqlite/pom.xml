<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.amsha</groupId>
        <artifactId>amsha-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>amsha-persistence-sqlite</artifactId>
    <name>amsha-persistence-sqlite</name>
    <description>SQLite-specific persistence adapter implementation</description>

    <dependencies>
        <!-- Persistence API (port interfaces) -->
        <dependency>
            <groupId>com.amsha</groupId>
            <artifactId>amsha-persistence-api</artifactId>
        </dependency>

        <!-- Shared JPA entities -->
        <dependency>
            <groupId>com.amsha</groupId>
            <artifactId>amsha-persistence-common</artifactId>
        </dependency>

        <!-- Shared utilities (LogUtil, SecretRedactor) — persistence knows only common + persistence-api -->
        <dependency>
            <groupId>com.amsha</groupId>
            <artifactId>amsha-common</artifactId>
        </dependency>

        <!-- LangChain4j embedding types for GlobalKnowledgeBase -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>

        <!-- Amsha Agent core domain (test fixtures only) -->
        <dependency>
            <groupId>com.amsha</groupId>
            <artifactId>amsha-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Quarkus CDI -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <!-- JDBI — thin SQL wrapper for SQLite -->
        <dependency>
          <groupId>io.quarkiverse.jdbi</groupId>
          <artifactId>quarkus-jdbi</artifactId>
        </dependency>

        <!-- Flyway for schema migration in tests -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>

        <!-- SQLite driver -->
        <dependency>
            <groupId>io.quarkiverse.jdbc</groupId>
            <artifactId>quarkus-jdbc-sqlite</artifactId>
        </dependency>

        <!-- Jakarta Enterprise APIs -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.jboss.logging</groupId>
            <artifactId>jboss-logging</artifactId>
        </dependency>

        <!--
          == Test-scope dependencies ==
          These satisfy CDI bean-graph validation for the core beans that are
          transitively indexed but NOT exercised in persistence tests.
        -->

        <!-- LangChain4j: provides EmbeddingModel / ChatModel synthetic beans -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-openai</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-ollama</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Channel API (IntentDetector, ChannelServices interfaces) -->
        <dependency>
            <groupId>com.amsha</groupId>
            <artifactId>amsha-channel-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Qute templates (required for PromptTemplateEngine during build-time CDI if not excluded) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-qute</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
            <scope>test</scope>
        </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-jacoco</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Real security impl beans for QuarkusTests booting the core CDI graph (S7 moved them out of core) -->
    <dependency>
      <groupId>com.amsha</groupId>
      <artifactId>amsha-security</artifactId>
      <scope>test</scope>
    </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${argLine} --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                        <amsha.persistence.backend>sqlite</amsha.persistence.backend>
                        <quarkus.flyway.enabled>true</quarkus.flyway.enabled>
                        <quarkus.flyway.migrate-at-start>true</quarkus.flyway.migrate-at-start>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <AMSHA_PERSISTENCE_BACKEND>sqlite</AMSHA_PERSISTENCE_BACKEND>
                        <QUARKUS_FLYWAY_ENABLED>true</QUARKUS_FLYWAY_ENABLED>
                        <QUARKUS_FLYWAY_MIGRATE_AT_START>true</QUARKUS_FLYWAY_MIGRATE_AT_START>
                    </environmentVariables>
                    <!-- Force sequential execution to prevent SQLite file locking and cleanup race conditions -->
                    <parallel>none</parallel>
                    <threadCount>1</threadCount>
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
