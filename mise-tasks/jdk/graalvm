#!/usr/bin/env bash
#MISE description="Switch active JDK to GraalVM Community 25.0.2 (for native builds)"
set -euo pipefail
mise use java@graalvm-community-25.0.2
echo ""
echo "✅  Active JDK switched to GraalVM Community 25.0.2"
java -version
echo ""
echo "Run native build:    mise run build:native"
echo "Switch back after:   mise run jdk:temurin"
