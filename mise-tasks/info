#!/usr/bin/env bash
#MISE description="Print runtime info: Java, Maven wrapper, Podman, Docker versions and DOCKER_HOST"
echo "── Java ────────────────────────────────────────"
java -version 2>&1
echo "── Maven wrapper ───────────────────────────────"
./mvnw --version 2>/dev/null || echo "  mvnw not executable — run: mise run setup"
echo "── Podman ──────────────────────────────────────"
podman --version 2>/dev/null || echo "  podman not installed"
echo "── Docker CLI ──────────────────────────────────"
docker --version 2>/dev/null || echo "  docker CLI not installed"
echo "── DOCKER_HOST ─────────────────────────────────"
echo "  ${DOCKER_HOST:-(not set)}"
echo "── ARCCLAW_VEC_EXT ─────────────────────────────"
echo "  ${ARCCLAW_VEC_EXT:-(not set)}"
