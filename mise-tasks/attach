#!/usr/bin/env bash
#MISE description="Run packaged jar — Telegram channel daemon (requires TELEGRAM_BOT_TOKEN in .env)"
set -euo pipefail
JAR="arcclaw-app/target/quarkus-app/quarkus-run.jar"
if [[ ! -f "$JAR" ]]; then
    echo "❌  JAR not found. Run: mise run build"
    exit 1
fi
if [[ -z "${TELEGRAM_BOT_TOKEN:-}" ]]; then
    echo "❌  TELEGRAM_BOT_TOKEN is not set in .env"
    exit 1
fi
JVM_ARGS=(
    "--add-opens=java.base/java.nio=ALL-UNNAMED"
    "--add-opens=java.base/jdk.internal.misc=ALL-UNNAMED"
    "--add-opens=java.base/java.lang=ALL-UNNAMED"
    "--enable-native-access=ALL-UNNAMED"
    "-Dsun.misc.unsafe.memory.access=allow"
    "-Dfile.encoding=UTF-8"
    "-Dstdout.encoding=UTF-8"
    "-Dsun.stdout.encoding=UTF-8"
    "-Dsun.stderr.encoding=UTF-8"
    "-Dquarkus.profile=cli"
    "-Darcclaw.telegram.enabled=true"
)
exec java "${JVM_ARGS[@]}" -jar "$JAR" attach
