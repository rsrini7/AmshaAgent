#!/usr/bin/env bash
#MISE description="Print Podman version, running containers, and tool-runner image status"
echo "── Podman version ───────────────────────────────"
podman --version 2>/dev/null || echo "  podman not found"
echo "── Running containers ───────────────────────────"
podman ps 2>/dev/null || echo "  (podman not running or no containers)"
echo "── arcclaw-tool-runner image ────────────────────"
if podman images 2>/dev/null | grep -q arcclaw-tool-runner; then
    podman images | grep arcclaw-tool-runner
else
    echo "  ⚠️  Image not found — run: mise run sandbox:build"
fi
echo "── DOCKER_HOST ──────────────────────────────────"
echo "  ${DOCKER_HOST:-(not set)}"
