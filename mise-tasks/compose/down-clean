#!/usr/bin/env bash
#MISE description="Stop the stack and DELETE all data volumes (irreversible — prompts for confirmation)"
set -euo pipefail
echo "⚠️   WARNING: This will permanently delete all data volumes."
read -r -p "Type YES to confirm: " confirm
if [[ "$confirm" == "YES" ]]; then
    docker compose down -v
    echo "✅  Stack and volumes removed."
else
    echo "Aborted."
    exit 1
fi
