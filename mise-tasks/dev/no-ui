#!/usr/bin/env bash
#MISE description="Dev mode — serve with Dev UI + console disabled (NPE workaround in Quarkus dev console)"
set -euo pipefail
exec ./mvnw quarkus:dev -pl arcclaw-app -am \
    '-Djvm.args=--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -Dsun.misc.unsafe.memory.access=allow' \
    "-Dquarkus.args=serve" \
    "-Dquarkus.profile=dev" \
    "-Dquarkus.console.enabled=false" \
    "-Dquarkus.devui.enabled=false" \
    "-Darcclaw.rag.vec-extension-path=../lib/vec0" \
    "-Darcclaw.data-dir=../data"
