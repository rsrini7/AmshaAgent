#!/usr/bin/env bash
#MISE description='Dev mode — one-shot task. Usage: mise run dev:ask -- "Your goal"'
#MISE alias="da"
set -euo pipefail
GOAL="${1:-${GOAL:-}}"
if [[ -z "$GOAL" ]]; then
    echo "Usage:  mise run dev:ask -- \"Your goal here\""
    echo "Or:     GOAL=\"Your goal\" mise run dev:ask"
    echo ""
    echo "Roles:  coordinator · researcher · architect · synthesizer · debugger"
    exit 1
fi
QARGS="ask $GOAL${ROLE:+ --role $ROLE}"
exec ./mvnw quarkus:dev -pl arcclaw-app -am \
    '-Djvm.args=--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -Dsun.misc.unsafe.memory.access=allow' \
    "-Dquarkus.args=$QARGS" \
    "-Dquarkus.profile=dev" \
    "-Darcclaw.rag.vec-extension-path=../lib/vec0" \
    "-Darcclaw.data-dir=../data"
