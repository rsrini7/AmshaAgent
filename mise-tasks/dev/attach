#!/usr/bin/env bash
#MISE description="Dev mode — Telegram daemon with hot reload (requires TELEGRAM_BOT_TOKEN in .env)"
set -euo pipefail
if [[ -z "${TELEGRAM_BOT_TOKEN:-}" ]]; then
    echo "❌  TELEGRAM_BOT_TOKEN is not set in .env"
    exit 1
fi
exec ./mvnw quarkus:dev -pl arcclaw-app -am \
    '-Djvm.args=--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -Dsun.misc.unsafe.memory.access=allow -Darcclaw.telegram.enabled=true' \
    "-Dquarkus.args=attach" \
    "-Dquarkus.profile=dev" \
    "-Darcclaw.rag.vec-extension-path=../lib/vec0" \
    "-Darcclaw.data-dir=../data"
