#!/usr/bin/env bash
#MISE description="Native build with 6 GB heap cap — auto-switches to GraalVM 25.0.2 and back after build"
set -euo pipefail

echo "→ Switching to GraalVM Community 25.0.2 for native build..."
mise use java@graalvm-community-25.0.2
echo "   JDK: $(java -version 2>&1 | head -1)"

export MAVEN_OPTS="--add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --enable-native-access=ALL-UNNAMED -Dsun.misc.unsafe.memory.access=allow -Dquarkus.otel.sdk.disabled=true"
./mvnw clean package -pl arcclaw-app -am -Pnative -DskipTests \
    "-Dquarkus.native.additional-build-args=-J-Xmx6g"
STATUS=$?

echo "→ Switching back to Temurin 25 ..."
mise use java@temurin-25
echo "   JDK: $(java -version 2>&1 | head -1)"

if [[ $STATUS -eq 0 ]]; then
    echo "✅  Native binary built with 6 GB heap cap."
else
    exit $STATUS
fi
