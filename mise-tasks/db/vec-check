#!/usr/bin/env bash
#MISE description="Check sqlite-vec extension exists for your platform (lib/vec0.so / .dylib)"
set -euo pipefail
if [[ "$(uname -s)" == "Darwin" ]]; then EXT="./lib/vec0.dylib"; else EXT="./lib/vec0.so"; fi
if [[ -f "$EXT" ]]; then
    echo "✅  sqlite-vec extension found: $EXT"
else
    echo "❌  Extension not found: $EXT — check lib/ for your platform binary."
    exit 1
fi
