#!/usr/bin/env bash
#MISE description="Run native binary — Telegram daemon (requires TELEGRAM_BOT_TOKEN in .env) (Linux/WSL2 only)"
set -euo pipefail
RUNNER="arcclaw-app/target/arcclaw-app-1.0.0-SNAPSHOT-runner"
if [[ ! -f "$RUNNER" ]]; then
    echo "❌  Native binary not found. Run: mise run build:native"
    exit 1
fi
if [[ -z "${TELEGRAM_BOT_TOKEN:-}" ]]; then
    echo "❌  TELEGRAM_BOT_TOKEN is not set in .env"
    exit 1
fi
export LD_PRELOAD=/lib/x86_64-linux-gnu/libm.so.6
exec "./$RUNNER" attach
