#!/usr/bin/env bash
#MISE description="Build the arcclaw-tool-runner Podman/Docker image (required before running in %prod)"
set -euo pipefail
if command -v docker &>/dev/null; then
    echo "→ Using Docker Compose..."
    docker compose build tool-runner
else
    echo "→ Using Podman directly..."
    podman build -t arcclaw-tool-runner:latest -f sandbox/Dockerfile.toolrunner sandbox/
fi
echo "✅  arcclaw-tool-runner image built."
