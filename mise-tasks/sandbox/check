#!/usr/bin/env bash
#MISE description="Verify the arcclaw-tool-runner sandbox image exists"
set -euo pipefail
if podman images | grep -q arcclaw-tool-runner; then
    echo "✅  arcclaw-tool-runner image is present."
    podman images | grep arcclaw-tool-runner
else
    echo "❌  Image not found. Run: mise run sandbox:build"
    exit 1
fi
