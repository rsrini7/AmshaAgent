{
  "name": "amsha-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Amsha Agent web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsrini7/AmshaAgent.git",
    "directory": "ui"
  },
  "type": "module",
  "scripts": {
    "generate-dto": "mvn -f ../app/pom.xml package -Pts-dto -DskipTests -q",
    "_comment_prebuild": "npm run generate-dto",
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lit/context": "^1.1.2",
    "dompurify": "^3.4.12",
    "lit": "^3.2.0",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@types/estree": "1.0.8",
    "cache-content-type": "1.0.1",
    "es-module-lexer": "1.7.0",
    "es-object-atoms": "1.1.1",
    "events-universal": "1.0.1",
    "lighthouse-logger": "1.4.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
