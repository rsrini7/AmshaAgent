{
  "name": "amsha-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate-dto": "mvn -f ../app/pom.xml package -Pts-dto -DskipTests -q",
    "_comment_prebuild": "npm run generate-dto",
