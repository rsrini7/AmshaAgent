# =============================================================================
# Amsha Agent - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your specific values.
# DO NOT commit the real '.env' file to version control.
#
# Quick-start defaults are provided where possible. Required fields are
# marked with [REQUIRED] - the app will not start without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime Profile
# -----------------------------------------------------------------------------
# Quarkus profile: prod | dev | test
QUARKUS_PROFILE=prod

# Runtime environment: development | production | staging
AMSHA_ENV=development


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Directory where Amsha Agent stores its SQLite databases and state files.
# Docker:  leave as ./data (volume-mounted at /app/data)
# Windows: use forward slashes or set to C:/Users/<user>/amsha-data
AMSHA_DATA_DIR=./data
AMSHA_WORKSPACE_ROOT_DIR=./data/workspaces

# Persistence backend selection: sqlite (default) | postgres | fs
# Controls @IfBuildProperty — evaluated at BUILD TIME, not just runtime.
# For SQLite (default): leave unset or comment out (enableIfMissing=true activates it).
# For PostgreSQL: set to "postgres" and use -Dquarkus.profile=cli,postgresql
# For Filesystem: set to "fs" and also set QUARKUS_FLYWAY_ENABLED=false below
# IMPORTANT: Rebuild the app after changing: ./mvnw clean package -pl app -DskipTests
# AMSHA_PERSISTENCE_BACKEND=sqlite

# Flyway (SQL migrations) — must be disabled for filesystem backend.
# Set to "false" when AMSHA_PERSISTENCE_BACKEND=fs
# QUARKUS_FLYWAY_ENABLED=true

# PostgreSQL backend (uncomment and fill in when using %postgresql profile)
# See app/src/main/resources/application.yaml for switching instructions.
# AMSHA_PG_HOST=localhost
# AMSHA_PG_PORT=5432
# AMSHA_PG_DB=amsha
# AMSHA_PG_USER=amsha
# AMSHA_PG_PASSWORD=changeme

# Flyway clean-on-start (dev profile only). Controls whether the database is
# wiped on each restart. Default is true (fresh schema every restart).
# Set to false to persist data across dev restarts.
# AMSHA_FLYWAY_CLEAN_AT_START=true

# Filesystem backend (uncomment when using %filesystem profile)
# AMSHA_FS_DATA_DIR=./data/fs
# AMSHA_FS_LUCENE_INDEX_DIR=lucene-index
# AMSHA_FS_VECTOR_DIMENSION=768


# -----------------------------------------------------------------------------
# HTTP / CORS
# -----------------------------------------------------------------------------
# Allowed CORS origins. Comma-separated for multiple.
AMSHA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080


# LLM Providers: groq | gemini | openrouter | ollama | openai | omlx | nvidia | cerebras | sarvam | opencode | huggingface | mistral | cloudflare | cohere | codex | claude-code | agy | kimchi | foundry | llamacpp | generic-openai | infinite-loop
# AMSHA_LLM_PROVIDER=groq
# AMSHA_LLM_PROVIDER=gemini
# AMSHA_LLM_PROVIDER=openrouter
# AMSHA_LLM_PROVIDER=ollama
# AMSHA_LLM_PROVIDER=openai
# AMSHA_LLM_PROVIDER=omlx
# AMSHA_LLM_PROVIDER=nvidia
# AMSHA_LLM_PROVIDER=cerebras
# AMSHA_LLM_PROVIDER=kimchi
# AMSHA_LLM_PROVIDER=foundry
# AMSHA_LLM_PROVIDER=generic-openai
AMSHA_LLM_PROVIDER=infinite-loop
# LLM model override (optional, used when provider is not infinite-loop)
# AMSHA_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Model used for the intent classifier when local Ollama classification is active
# AMSHA_INTENT_CLASSIFIER_OLLAMA_MODEL=mistral-small:latest

# ── Vault Priority ──
# When true: the onboarding UI's provider/model/key in the vault takes priority
# over the .env config. When false (default): .env config is always used
# (recommended for infinite-loop power users who bypass the UI onboarding).
AMSHA_LLM_VAULT_PRIORITY=false

# When true: O3 profile-scoped routing resolves owned/workspace/system model profiles from
# the LlmProfileStorePort precedence chain, taking priority over deployment persona/group/global
# config. When false (default): legacy deployment/system routing is used.
AMSHA_LLM_PROFILE_ROUTING_ENABLED=false

# When true: explicitly skip onboarding and go straight to chat.
# When false: explicit skip is disabled, but a ready environment/vault LLM
# configuration can still mark onboarding preconfigured and bypass the wizard.
# AMSHA_UI_SKIP_ONBOARDING=false

# Local development only: allow the onboarding UI to reissue the existing
# owner credential after browser state is lost. Never enable on shared hosts.
# AMSHA_BOOTSTRAP_LOCAL_RECOVERY=true

# ── Infinite Loop: Multi-provider round-robin with infinite fallback ──
# Set AMSHA_LLM_PROVIDER=infinite-loop to activate.
# On failure/rate-limit, the next provider is tried in round-robin order.
# After the last provider, loops back to the first (never-ending).
# Only fails when ALL providers have permanent auth errors.
#
# Multi-key/model support: comma-separate API keys and/or model names.
# On rate limit, rotates to the next key within the same provider slot
# before moving to a different provider. Examples:
#   AMSHA_GROQ_API_KEY=key1,key2,key3    (3 keys, same model)
#   AMSHA_GROQ_MODEL=model-a,model-b     (1 key, 2 models)
#   AMSHA_GROQ_API_KEY=k1,k2             (paired by index with models)
# AMSHA_INFINITE_LOOP_LLM_PROVIDERS=llamacpp,ollama,omlx,groq,openrouter,nvidia,cerebras,gemini,generic-openai,agy,kimchi,foundry,huuggingface,mistral,cloudflare,cohere,codex,claude-code,sarvam,opencode
#AMSHA_INFINITE_LOOP_LLM_PROVIDERS=groq,openrouter,nvidia,generic-openai
AMSHA_INFINITE_LOOP_COOLDOWN_BASE_SECONDS=5
AMSHA_INFINITE_LOOP_COOLDOWN_MAX_SECONDS=300
AMSHA_INFINITE_LOOP_COOLDOWN_TRANSIENT_SECONDS=5

# -----------------------------------------------------------------------------
# Per-Persona / Per-Group Model Routing (P102)
# -----------------------------------------------------------------------------
# Override the default LLM model per agent persona or group (Loka).
# Resolution: persona override → group default → global default.
#
# Single model (env var):
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_PROVIDER=deepseek
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_MODEL=deepseek-coder-33b
#
# Group default (env var):
#   AMSHA_LLM_GROUP_MODELS_KAILASA_PROVIDER=groq
#   AMSHA_LLM_GROUP_MODELS_KAILASA_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# Multi-model failover (numbered):
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_PROVIDER=deepseek
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_MODEL=deepseek-coder-33b
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_PROVIDER=groq
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_MODEL=llama-3.3-70b
#
# Also configurable via YAML (application.yaml) under amsha.llm.persona.models.
#
# Circuit breaker per-model isolation is automatic.
# A failure in one provider (e.g. Groq rate-limit) will NOT trip
# the circuit for other providers (e.g. OpenAI, Gemini).
AMSHA_LLM_CIRCUIT_BREAKER_ENABLED=true

# --- Group/Persona Model Overrides for Connectivity testing ---
# AMSHA_LLM_GROUP_MODELS_KAILASA_PROVIDER=groq
# AMSHA_LLM_GROUP_MODELS_KAILASA_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Multi-model failover test for Brahma persona (deity/alias name for Coder)
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_PROVIDER=generic-openai
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_MODEL=non-existent-failover-model
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_PROVIDER=groq
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AMSHA_LLM_PERSONA_MODELS_RESEARCHER_PROVIDER=cerebras
# AMSHA_LLM_PERSONA_MODELS_RESEARCHER_MODEL=gpt-oss-120b


# ── Headroom: LLM Context Compression Proxy ──
# Headroom sits between Amsha Agent and remote LLM providers to compress
# context windows using semantic layers, reducing token costs by 30-60%.
# Set AMSHA_HEADROOM_ENABLED=true to route ALL providers through Headroom.
# After changing this, restart Amsha Agent for the change to take effect.
#
# Headroom proxies auto-start via:  mise run headroom:start-all
# and auto-stop via:               mise run headroom:stop-all
#
# Requirements: uv (https://github.com/astral-sh/uv) must be installed.
#
# Port map (remote providers first, local providers last):
#   openrouter  → http://localhost:8788/v1
#   groq        → http://localhost:8789/v1
#   nvidia      → http://localhost:8790/v1
#   cerebras    → http://localhost:8791/v1
#   gemini      → http://localhost:8792/v1  (uses --backend gemini)
#   openai      → http://localhost:8793/v1
#   ollama      → http://localhost:8794/v1
#   omlx        → http://localhost:8795/v1
#   generic-openai → http://localhost:8796/v1
#   llamacpp    → http://localhost:8797/v1
#
# To enable: set AMSHA_HEADROOM_ENABLED=true and uncomment the proxy
# BASE_URL lines on your provider configs below.
AMSHA_HEADROOM_ENABLED=false

# Headroom proxy ports (auto-managed by mise run headroom:start-all):
#AMSHA_HEADROOM_OPENROUTER_PORT=8788
#AMSHA_HEADROOM_GROQ_PORT=8789
#AMSHA_HEADROOM_NVIDIA_PORT=8790
#AMSHA_HEADROOM_CEREBRAS_PORT=8791
#AMSHA_HEADROOM_GEMINI_PORT=8792
#AMSHA_HEADROOM_OPENAI_PORT=8793
#AMSHA_HEADROOM_OLLAMA_PORT=8794
#AMSHA_HEADROOM_OMLX_PORT=8795
#AMSHA_HEADROOM_GENERIC_OPENAI_PORT=8796
#AMSHA_HEADROOM_LLAMACPP_PORT=8797

# Headroom launcher tuning (used by .mise/tasks/headroom/*.ps1)
# Pin the uvx package version. Scripts default to 0.25.0 if unset.
#HEADROOM_VERSION=0.25.0
# Override the memory embedder runtime. On Apple Silicon this auto-defaults to
# pytorch_mps; set to empty to disable, or set another value to force it.
#HEADROOM_EMBEDDER_RUNTIME=pytorch_mps


# Max latency before a slow provider is treated as failure and the loop switches (ms).
# NVIDIA cold-start on free tier can take 60-90s — increase to 120000 if needed.
AMSHA_INFINITE_LOOP_MAX_LATENCY_MS=45000

# Infinite-loop provider lists per concern (independent of each other).
AMSHA_INFINITE_LOOP_COMPACTION_PROVIDERS=groq,ollama
AMSHA_INFINITE_LOOP_CLASSIFIER_PROVIDERS=groq,ollama
AMSHA_INFINITE_LOOP_EMBEDDING_PROVIDERS=ollama

# ── Test Mode: Force error instead of dummy fallback ──
# When running in test profile (e.g., `mvnw test`), infinite-loop providers
# inject dummy fallbacks (static "Dummy response") if all slots fail.
# Set to `true` to force real error paths instead of dummy fallbacks.
# Useful for testing error-handling logic explicitly.
# (System property: -Damsha.test.force-error=true)
# amsha.test.force-error=false


# -----------------------------------------------------------------------------
# Per-Provider API Keys & Config
# -----------------------------------------------------------------------------
# Each provider has its own dedicated env var. No shared keys.
# Default infinite-loop uses: omlx, groq, openrouter.
# Uncommented lines below are the default loop — override <...> placeholders.
# For other providers, uncomment and configure as needed.

# --- Groq ---
# Multi-key: comma-separated API keys rotate on rate limit (key1,key2,key3)
# Multi-model: comma-separated models rotate on failure (model-a,model-b)
AMSHA_GROQ_API_KEY=<groq-api-key-1>,<groq-api-key-2>
# AMSHA_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AMSHA_GROQ_BASE_URL=http://localhost:8789/v1  # via Headroom proxy
AMSHA_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AMSHA_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b,llama-3.3-70b-versatile

# --- Gemini ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_GEMINI_API_KEY=<gemini-api-key-1>,<gemini-api-key-2>
AMSHA_GEMINI_MODEL=gemini-3.1-flash-lite,gemini-2.0-flash-lite

# --- OpenRouter ---
# Multi-key: comma-separated API keys rotate on rate limit
AMSHA_OPENROUTER_API_KEY=sk-or-<your-key-1>,sk-or-<your-key-2>
# AMSHA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AMSHA_OPENROUTER_BASE_URL=http://localhost:8788/v1  # via Headroom proxy
AMSHA_OPENROUTER_MODEL=openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free
# AMSHA_OPENROUTER_APP_NAME=https://github.com/rsrini7/amsha
# AMSHA_OPENROUTER_SITE_URL=https://github.com/rsrini7/amsha

# --- NVIDIA ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_NVIDIA_API_KEY=nvapi-<your-key-1>,nvapi-<your-key-2>
# AMSHA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AMSHA_NVIDIA_BASE_URL=http://localhost:8790/v1  # via Headroom proxy
# AMSHA_NVIDIA_MODEL=meta/llama-3.1-8b-instruct,microsoft/phi-4-multimodal-instruct

# --- Cerebras ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_CEREBRAS_API_KEY=csk-<your-key-1>,csk-<your-key-2>
# AMSHA_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# AMSHA_CEREBRAS_BASE_URL=http://localhost:8791/v1  # via Headroom proxy
# Only qwen-3-235b for agent loop (llama3.1-8b has 8192 context — too small)
# AMSHA_CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# --- Sarvam ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_SARVAM_API_KEY=<your-key>
# AMSHA_SARVAM_BASE_URL=https://api.sarvam.ai/v1
# AMSHA_SARVAM_MODEL=sarvam-105b


# --- OpenCode ---
# OpenCode Zen (pay-per-use): https://opencode.ai/zen/v1
# OpenCode Go (subscription): https://opencode.ai/zen/go/v1
# AMSHA_OPENCODE_API_KEY=<your-key>
# AMSHA_OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# AMSHA_OPENCODE_MODEL=deepseek-v4-flash-free

# --- Hugging Face ---
# Hugging Face Inference API / Router: https://router.huggingface.co/v1
# AMSHA_HUGGINGFACE_API_KEY=hf_<your-token>
# AMSHA_HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
# AMSHA_HUGGINGFACE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# --- Mistral AI ---
# Mistral AI / La Plateforme: https://console.mistral.ai
# AMSHA_MISTRAL_API_KEY=<your-key>
# AMSHA_MISTRAL_BASE_URL=https://api.mistral.ai/v1
# AMSHA_MISTRAL_MODEL=codestral-latest

# --- Cloudflare Workers AI ---
# Cloudflare Workers AI: https://dash.cloudflare.com
# AMSHA_CLOUDFLARE_API_KEY=<your-api-token>
# AMSHA_CLOUDFLARE_ACCOUNT_ID=<your-account-id>
# AMSHA_CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/v1
# AMSHA_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Cohere ---
# Cohere (OpenAI Compatibility API): https://dashboard.cohere.com
# AMSHA_COHERE_API_KEY=<your-cohere-api-key>
# AMSHA_COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
# AMSHA_COHERE_MODEL=command-r-plus-08-2024

# --- Codex CLI (ChatGPT Plus OAuth) ---
# Automatically extracts OAuth session from ~/.codex/auth.json (no key required if logged into codex CLI)
# AMSHA_CODEX_API_KEY=<optional-direct-key-or-token>
# AMSHA_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex  # Direct ChatGPT Plus Responses endpoint (or http://127.0.0.1:8787/v1 for hroom proxy, or https://api.openai.com/v1)
# AMSHA_CODEX_MODEL=gpt-5.6-luna

# --- Claude Code CLI (Anthropic OAuth / API Key) ---
# Automatically extracts OAuth session from macOS Keychain or ~/.claude/.credentials.json
# Fallback environment variables: AMSHA_CLAUDE_CODE_API_KEY, CLAUDE_CODE_OAUTH_TOKEN
# AMSHA_CLAUDE_CODE_API_KEY=<optional-direct-api-key-or-oauth-token>
# CLAUDE_CODE_OAUTH_TOKEN=<optional-oauth-token>
# AMSHA_CLAUDE_CODE_BASE_URL=https://api.anthropic.com
# AMSHA_CLAUDE_CODE_MODEL=claude-sonnet-4-5

# --- Antigravity CLI (agy / Google Gemini API) ---
# Automatically extracts OAuth session / API key from macOS Keychain or ~/.gemini/antigravity-cli/settings.json
# Fallback environment variables: AMSHA_AGY_API_KEY, AGY_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY
# AMSHA_AGY_API_KEY=<optional-direct-api-key-or-oauth-token>
# AMSHA_AGY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AMSHA_AGY_MODEL=gemini-3.1-flash-lite

# --- Kimchi (kimchi.dev / Free Tier) ---
# Automatically extracts API key from ~/.config/kimchi/config.json or ~/.config/opencode/opencode.json
# Fallback environment variables: AMSHA_KIMCHI_API_KEY, KIMCHI_API_KEY
# AMSHA_KIMCHI_API_KEY=<optional-direct-api-key>
# AMSHA_KIMCHI_BASE_URL=https://llm.kimchi.dev/openai/v1
# AMSHA_KIMCHI_MODEL=minimax-m3,deepseek-v4-flash,kimi-k2.7,nemotron-3-ultra-fp4

# --- Foundry Local (Local ONNX / Microsoft Foundry CLI) ---
# Automatically discovers active daemon port from ~/.foundry/daemon.json
# Fallback to local CLI binary (foundry) when daemon is stopped
# AMSHA_FOUNDRY_BASE_URL=http://127.0.0.1:8000/v1
# AMSHA_FOUNDRY_MODEL=qwen3-14b,phi-4-mini,smollm3-3b
# AMSHA_FOUNDRY_EXE=/opt/homebrew/bin/foundry

# --- OpenAI ---
# AMSHA_OPENAI_API_KEY=sk-<your-key>
# AMSHA_OPENAI_BASE_URL=https://api.openai.com/v1
# AMSHA_OPENAI_BASE_URL=http://localhost:8793/v1  # via Headroom proxy
# AMSHA_OPENAI_MODEL=gpt-4o,gpt-4o-mini

# --- Generic OpenAI-compatible (any endpoint) ---
# DeepSeek v4/r1 models auto-disable thinking mode to avoid "reasoning_content must be passed back" errors
# Extra body params: JSON object injected into the OpenAI request body (overrides auto-detect)
# AMSHA_GENERIC_OPENAI_EXTRA_BODY={"thinking": {"type": "disabled"}}
# AMSHA_GENERIC_OPENAI_API_KEY=sk-<your-key>
# AMSHA_GENERIC_OPENAI_MODEL=deepseek-v4-flash
# AMSHA_GENERIC_OPENAI_BASE_URL=https://api.example.com/v1
# AMSHA_GENERIC_OPENAI_BASE_URL=http://localhost:8796/v1  # via Headroom proxy
# AMSHA_GENERIC_OPENAI_TARGET_URL=https://api.example.com/v1

# --- OMLX (local, multi-model rotation) ---
# AMSHA_OMLX_API_KEY=needed
# AMSHA_OMLX_BASE_URL=http://127.0.0.1:8000/v1
# AMSHA_OMLX_BASE_URL=http://localhost:8795/v1  # via Headroom proxy
# Multi-model: comma-separated local models rotate on failure
# Removed: GLM-4.7-Flash (246s), MiMo-V2.5-ASR (server error)
# AMSHA_OMLX_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit,mlx-community/gemma-4-26b-a4b-it-4bit

# -----------------------------------------------------------------------------
# llama.cpp local inference server (OpenAI-compatible API).
# Start: ./server -m model.gguf --port 9000
# AMSHA_LLAMACPP_BASE_URL=http://localhost:9000/v1
# AMSHA_LLAMACPP_BASE_URL=http://localhost:8797/v1  # via Headroom proxy
# AMSHA_LLAMACPP_MODEL=qwen3

# -----------------------------------------------------------------------------
# LLM - Ollama (local, shared by chat + embeddings)
# -----------------------------------------------------------------------------
# Base URL for the local Ollama instance.
# Docker:  http://ollama:11434  (service name on compose network)
# Local:   http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# Chat model loaded into Ollama (used only if switching away from Groq).
# OLLAMA_MODEL=mistral-small:latest


# Manually force 'Compact Prompt Mode' (condensed security and architectural rules).
AMSHA_LLM_COMPACT_PROMPT_ENABLED=true
AMSHA_LLM_COMPACT_PROMPT_MAX_CHARS=32000

# Strategy for ensuring structured output (JSON schema compliance).
# Modes: NATIVE (default), PROMPT_DIRECTIVE (forced JSON-only instructions), LENIENT.
# Auto-set by bootstrap: PROMPT_DIRECTIVE for llama-4-scout, NATIVE for others.
# AMSHA_LLM_STRUCTURED_OUTPUT_MODE=NATIVE
# AMSHA_LLM_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE
# AMSHA_INTENT_CLASSIFIER_STRUCTURED_OUTPUT_MODE=NATIVE
# AMSHA_INTENT_CLASSIFIER_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE
# AMSHA_COMPACTION_STRUCTURED_OUTPUT_MODE=NATIVE
# AMSHA_COMPACTION_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE


# Enable Ollama fallback for intent classification (default: false).
# When disabled, intent classifier failures fallback immediately to local heuristics.
# AMSHA_INTENT_CLASSIFIER_OLLAMA_FALLBACK_ENABLED=false


# Context window size (in tokens). 
# Triggered 'Compact Prompt Mode' if <= 8192 to fit within small windows.
# Auto-set by bootstrap: 8192 (Cerebras-Llama/Ollama), 64k (Cerebras-Qwen), 1M (Gemini), 128k (Others)
# AMSHA_LLM_CONTEXT_WINDOW=1000000
AMSHA_LLM_CONTEXT_WINDOW=128000
# AMSHA_LLM_CONTEXT_WINDOW=16384
# AMSHA_LLM_CONTEXT_WINDOW=8192
# AMSHA_LLM_CONTEXT_WINDOW=4096


# -----------------------------------------------------------------------------
# Compaction Provider Config (per-provider keys)
# -----------------------------------------------------------------------------
# Keys follow pattern: AMSHA_COMPACTION_{PROVIDER}_{KEY}
# Providers listed in AMSHA_INFINITE_LOOP_COMPACTION_PROVIDERS must have config here.
# OMLX needs no dedicated block: amsha.llm.omlx.* mirrors the standard AMSHA_OMLX_* vars.
# For other providers, set per-provider keys as below (AMSHA_COMPACTION_{PROVIDER}_{KEY}).
# Use provider names such as groq or ollama; `infinite-loop` is the wrapper,
# not a compaction provider with its own MODEL/BASE_URL settings.

# --- Groq Compaction ---
# Set PROMPT_DIRECTIVE if Groq hits: "json mode cannot be combined with tool/function calling"
AMSHA_COMPACTION_GROQ_API_KEY=<compaction-groq-api-key>
AMSHA_COMPACTION_GROQ_MODEL=llama-3.1-8b-instant
# AMSHA_COMPACTION_GROQ_BASE_URL=http://localhost:8789/v1  # via Headroom proxy
AMSHA_COMPACTION_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AMSHA_COMPACTION_GROQ_MAX_RETRIES=3

# --- Ollama Compaction ---
AMSHA_COMPACTION_OLLAMA_MODEL=mistral-small:latest
AMSHA_COMPACTION_OLLAMA_BASE_URL=http://localhost:11434
# AMSHA_COMPACTION_OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# --- Cerebras Compaction (uncomment to use) ---
# AMSHA_COMPACTION_CEREBRAS_API_KEY=<compaction-cerebras-api-key>
# AMSHA_COMPACTION_CEREBRAS_MODEL=llama3.1-8b
# AMSHA_COMPACTION_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- OpenRouter Compaction (uncomment to use) ---
# AMSHA_COMPACTION_OPENROUTER_API_KEY=<compaction-openrouter-api-key>
# AMSHA_COMPACTION_OPENROUTER_MODEL=openai/gpt-oss-20b:free
