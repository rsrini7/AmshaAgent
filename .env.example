# -----------------------------------------------------------------------------
# Embedding Provider Config (per-provider keys)
# -----------------------------------------------------------------------------
# Optional in-process ONNX Runtime compatibility spike. Disabled until a verified
# model bundle and tokenizer binding have passed validation.
AMSHA_ONNX_ENABLED=false
AMSHA_ONNX_MODEL_ROOT=./data/models
AMSHA_ONNX_MAX_MODEL_FILE_BYTES=1073741824
AMSHA_ONNX_MAX_LOADED_MODELS=2
AMSHA_ONNX_MAX_RESIDENT_MB=1024
AMSHA_ONNX_INFERENCE_THREADS=2
AMSHA_ONNX_QUEUE_CAPACITY=64
AMSHA_ONNX_SHUTDOWN_GRACE=PT10S
AMSHA_ONNX_MAX_INPUT_BYTES=262144
AMSHA_ONNX_MAX_BATCH_INPUT_BYTES=1048576
AMSHA_ONNX_MAX_BATCH_SIZE=32
AMSHA_ONNX_WARMUP_ENABLED=true
AMSHA_ONNX_WARMUP_MAX_PROBES=5
AMSHA_ONNX_WARMUP_TIMEOUT=PT3S
# classification is shadow-only and disabled until separately approved
# classifier bundles, datasets, calibration, and model cards are installed.
# Data collection from REST test automation (requires corresponding test headers)
AMSHA_TEST_DATA_COLLECTION_ENABLED=false
AMSHA_CLASSIFIER_SHADOW_THREADS=2
AMSHA_CLASSIFIER_SHADOW_QUEUE_CAPACITY=64
AMSHA_CLASSIFIER_SHADOW_SHUTDOWN_GRACE=PT5S
AMSHA_ONNX_CLASSIFIER_CIRCUIT_FAILURE_THRESHOLD=3
AMSHA_ONNX_CLASSIFIER_CIRCUIT_COOLDOWN_SECONDS=30
# These values enable shadow inference and initialize requested state.
# Effective behavior additionally requires a registered, ready active implementation.
AMSHA_ONNX_CLASSIFIER_INTENT_ENABLED=false
AMSHA_ONNX_CLASSIFIER_INTENT_MODEL=
AMSHA_ONNX_CLASSIFIER_INTENT_TIMEOUT_SECONDS=2
AMSHA_ONNX_CLASSIFIER_TOOL_RISK_ENABLED=false
AMSHA_ONNX_CLASSIFIER_TOOL_RISK_MODEL=
AMSHA_ONNX_CLASSIFIER_TOOL_RISK_TIMEOUT_SECONDS=2
AMSHA_ONNX_CLASSIFIER_ANSWER_QUALITY_ENABLED=false
AMSHA_ONNX_CLASSIFIER_ANSWER_QUALITY_MODEL=
AMSHA_ONNX_CLASSIFIER_ANSWER_QUALITY_TIMEOUT_SECONDS=2

# Decision Plane Shadow Classifiers (observational only, disabled by default)
AMSHA_DECISION_SHADOW_INTENT_ENABLED=false
AMSHA_DECISION_SHADOW_TOOL_RISK_ENABLED=false
AMSHA_DECISION_SHADOW_ANSWER_QUALITY_ENABLED=false

# Decision Plane Intent Routing Pilot (Issue 07, disabled by default)
# When disabled, intent classification uses the authoritative structured LLM and deterministic fallback.
AMSHA_ROUTING_INTENT_DECISION_ROUTER_ENABLED=false
# AMSHA_ROUTING_INTENT_DECISION_ROUTER_REVIEW_BAND_LOW=0.50
# AMSHA_ROUTING_INTENT_DECISION_ROUTER_REVIEW_BAND_HIGH=0.85
# AMSHA_ROUTING_INTENT_DECISION_ROUTER_TIMEOUT_MS=50000
# Activation gate: Pilot is Deferred. Even when enabled=true, direct routing is blocked
# until candidate evidence is approved, cost ceiling is approved, and rollout owner is assigned.
#
# ROLLOUT_OWNER has NO closed set of allowed values. The only rule the code enforces is
# NON-BLANK — IntentDecisionRouter.isActivationGateApproved() is literally
# `candidateEvidenceApproved && costCeilingApproved && rolloutOwner != null && !rolloutOwner.isBlank()`.
# So ANY non-blank string opens the gate, and this is the only one of the three criteria that is
# free text; the other two are booleans.
#
# Put the ACCOUNTABLE OWNER for both rollout AND rollback here — a person or a team, never a status.
#   good:  platform-ml@example.com   |   @your-handle   |   team:platform-ml
#   junk:  true   TBD   n/a   x   "approved"    <- all OPEN the gate while meaning nothing
# A junk value is worse than a blank one: blank is the honest "not approved" state and keeps the
# pilot Deferred, whereas a placeholder silently reports the gate as satisfied. If no owner has been
# formally assigned, LEAVE IT EMPTY. Never invent a value to unblock a run.
#
# A placeholder is not silently accepted at runtime: ActivationGateReadiness logs one WARN at startup
# when both booleans below are true and this value looks like a placeholder. It is advisory only — it
# does not reject the value, normalise it, or close the gate.
# AMSHA_ROUTING_INTENT_DECISION_ROUTER_ACTIVATION_GATE_CANDIDATE_EVIDENCE_APPROVED=false
# AMSHA_ROUTING_INTENT_DECISION_ROUTER_ACTIVATION_GATE_COST_CEILING_APPROVED=false
# AMSHA_ROUTING_INTENT_DECISION_ROUTER_ACTIVATION_GATE_ROLLOUT_OWNER=

# ---------------------------------------------------------------------------
# Decision Provider (Jev / System One) — INERT, disabled by default
# ---------------------------------------------------------------------------
# Selects which provider answers decision (choice / score / noul) requests, the same way
# AMSHA_LLM_PROVIDER selects an LLM provider above. Leave AMSHA_DECISION_PROVIDER empty to keep
# the decision plane off. Selecting a provider is NOT the same as activating it: the plane stays
# Deferred until a decision engine is wired and approved, so setting these values changes nothing
# today.
#
# Two axes, exactly as on the LLM side — a provider is an ENDPOINT, a model is what is served there:
#   * the provider id names the System One endpoint that receives POST /v1/systemone, just as an
#     LLM provider is the endpoint that receives /v1/chat/completions. It may be a specific
#     decision server (laya, kev, clm), a generic local runtime host that serves whichever
#     decision model is loaded into it (omlx), or a hosted API (typesafe).
#   * AMSHA_DECISION_{PROVIDER}_MODEL names the checkpoint served at that endpoint — the same role
#     AMSHA_<PROVIDER>_MODEL plays for the LLM providers. That is why `omlx` (a runtime) and
#     `laya` (a model) are both valid provider ids: the runtime slot serves either one by
#     changing the model.
#     It is REQUIRED for a remote provider (the hosted System One contract makes `model`
#     mandatory, so a remote slot without one is refused) and OPTIONAL for a self-hosted one,
#     where blank means "the server picks its own checkpoint" and the request leaves the field
#     out entirely.
#
# The lane is derived from the endpoint host, never declared:
#   the literal 127.0.0.1  -> self-hosted lane (loopback-validated)
#   any other host         -> remote lane (HTTPS enforced by the outbound policy)
# "localhost", "::1" and other 127.x addresses are refused as ambiguous — use the literal
# 127.0.0.1 so the lane cannot be misread.
#
# AMSHA_DECISION_{PROVIDER}_API_KEY is the direct provider key, following
# the same environment-backed pattern as Amsha's other providers. Keep its
# value only in your ignored local .env; never commit, print, or log it.
# Evaluation copies the key to request-owned bytes and clears them after use.
# The source configuration String remains in memory for the process lifetime; the
# provider configuration may retain an immutable String for the engine lifetime.
# AMSHA_DECISION_{PROVIDER}_WIRE_PROFILE belongs to the MODEL, not the endpoint: a CLM model must
# declare PROSE, and the selector refuses the contradiction rather than sending it.
#
# AMSHA_DECISION_{PROVIDER}_GOVERNANCE_* declares that slot's data-governance terms. The parent ADR
# requires retention, residency, training-use and tenant-isolation to be declared explicitly before
# state may leave the process. Declaring them records an operator decision; it activates nothing.
# The selector refuses an enabled slot whose declaration is incomplete:
#   * _GOVERNANCE_PROJECTION_ALLOW_LIST is required on BOTH lanes and must be non-empty — it is the
#     comma-separated list of top-level `state` field names permitted to leave the process. The
#     tool-risk evaluation state uses the camel-case `requiredOperation` key; include it in each
#     enabled slot's list when evaluating tool-risk decisions.
#     projection redactor fails closed without it, so an enabled slot with an empty list is refused.
#   * _GOVERNANCE_DATA_LOCATION is the provider-confirmed country/region where submitted
#     state is processed or stored. Get it from the provider account terms or data-processing
#     agreement; do not infer it from the endpoint or guess. The Jev ADR currently records
#     TypeSafe residency as undeclared. Leave it blank until TypeSafe confirms it; the remote
#     slot stays unavailable meanwhile. Loopback slots never export state off the machine.
#   * _GOVERNANCE_ALLOW_TRAINING_USE must stay false and _GOVERNANCE_TENANT_ISOLATION must stay
#     true; a contrary value is refused rather than sent.
#   * _GOVERNANCE_RETENTION_WINDOW defaults to PT0S (zero retention) — a positive statement, not an
#     absence of one.
#   * _GOVERNANCE_COST_CEILING_PER_THOUSAND is required before production activation, not to gather
#     evaluation evidence.
#
# Keys follow pattern: AMSHA_DECISION_{PROVIDER}_{KEY}
AMSHA_DECISION_PROVIDER=

# Opt-in evaluation path (W4). When false — the shipped value — the internal evaluation endpoints
# refuse before any provider is touched, so no egress is possible. Enabling it lets an operator run
# the two registered decisions (amsha.routing.intent.v1 and tool.risk.shadow) and gather evidence.
# It does NOT register a decision engine and does NOT activate routing: the plane stays Deferred.
AMSHA_DECISION_EVALUATION_ENABLED=false

# Operations monitoring (W6). Bounded, payload-free observation of the evaluations the opt-in path
# runs. DRIFT compares the mean confidence and abstention rate of the most recent WINDOW observations
# on a lane against the first WINDOW, and logs one WARN per drift episode. COST_WINDOW is how many
# priced decisions make up the rolling cost per 1,000 that an approved per-slot ceiling is checked
# against. Neither activates the plane.
AMSHA_DECISION_DRIFT_WINDOW=64
AMSHA_DECISION_DRIFT_CONFIDENCE_THRESHOLD=0.15
AMSHA_DECISION_DRIFT_ABSTENTION_THRESHOLD=0.20
AMSHA_DECISION_COST_WINDOW=1000

# --- TypeSafe Jev (closed hosted reference implementation, remote lane) ---
# AMSHA_DECISION_TYPESAFE_ENABLED=false
# AMSHA_DECISION_TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
# AMSHA_DECISION_TYPESAFE_MODEL=jev-latest
# AMSHA_DECISION_TYPESAFE_API_KEY=
# AMSHA_DECISION_TYPESAFE_TIMEOUT=PT50S
# AMSHA_DECISION_TYPESAFE_WIRE_PROFILE=JSON_OBJECT
# AMSHA_DECISION_TYPESAFE_GOVERNANCE_DATA_LOCATION=
# AMSHA_DECISION_TYPESAFE_GOVERNANCE_RETENTION_WINDOW=PT0S
# AMSHA_DECISION_TYPESAFE_GOVERNANCE_ALLOW_TRAINING_USE=false
# AMSHA_DECISION_TYPESAFE_GOVERNANCE_TENANT_ISOLATION=true
# AMSHA_DECISION_TYPESAFE_GOVERNANCE_PROJECTION_ALLOW_LIST=
# AMSHA_DECISION_TYPESAFE_GOVERNANCE_COST_CEILING_PER_THOUSAND=

# --- CLM (contrastive System One model, self-hosted) ---
# CLM's heads were trained on prose, so a JSON `state` degrades answers silently instead of
# failing loudly. PROSE is therefore the correct value here, and a projection that cannot be
# rendered as prose fails closed rather than being coerced. Upstream clm-serve listens on :8700;
# the MLX build ships no HTTP server at all, so it needs a loopback wrapper first.
# AMSHA_DECISION_CLM_ENABLED=false
# AMSHA_DECISION_CLM_ENDPOINT=http://127.0.0.1:8000/v1/systemone
# AMSHA_DECISION_CLM_MODEL=CLM-v0.1-8B-MLX-8bit
# AMSHA_DECISION_CLM_API_KEY=
# AMSHA_DECISION_CLM_TIMEOUT=PT50S
# AMSHA_DECISION_CLM_WIRE_PROFILE=PROSE
# AMSHA_DECISION_CLM_GOVERNANCE_DATA_LOCATION=
# AMSHA_DECISION_CLM_GOVERNANCE_RETENTION_WINDOW=PT0S
# AMSHA_DECISION_CLM_GOVERNANCE_ALLOW_TRAINING_USE=false
# AMSHA_DECISION_CLM_GOVERNANCE_TENANT_ISOLATION=true
# AMSHA_DECISION_CLM_GOVERNANCE_PROJECTION_ALLOW_LIST=
# AMSHA_DECISION_CLM_GOVERNANCE_COST_CEILING_PER_THOUSAND=

# --- Laya (Apache-2.0, Jev-wire-compatible server, self-hosted) ---
# Bind laya-serve to 127.0.0.1 explicitly: it defaults to 0.0.0.0, which exposes it to the LAN.
# AMSHA_DECISION_LAYA_ENABLED=false
# AMSHA_DECISION_LAYA_ENDPOINT=http://127.0.0.1:8000/v1/systemone
# AMSHA_DECISION_LAYA_MODEL=sahilchachra/Laya-TypedDecisions-MXFP8
# AMSHA_DECISION_LAYA_API_KEY=
# AMSHA_DECISION_LAYA_TIMEOUT=PT50S
# AMSHA_DECISION_LAYA_WIRE_PROFILE=JSON_OBJECT
# AMSHA_DECISION_LAYA_GOVERNANCE_DATA_LOCATION=US
# AMSHA_DECISION_LAYA_GOVERNANCE_RETENTION_WINDOW=PT0S
# AMSHA_DECISION_LAYA_GOVERNANCE_ALLOW_TRAINING_USE=false
# AMSHA_DECISION_LAYA_GOVERNANCE_TENANT_ISOLATION=true
# AMSHA_DECISION_LAYA_GOVERNANCE_PROJECTION_ALLOW_LIST=user_message,agentRole,autonomyLevel,toolName,parameters,goal
# AMSHA_DECISION_LAYA_GOVERNANCE_COST_CEILING_PER_THOUSAND=

# --- Kev (Apache-2.0, LLM-backed rather than a dedicated decision head) ---
# MODEL is blank on purpose: it names whichever checkpoint this server wraps, which is
# deployment-specific. A self-hosted slot may omit it — the request then leaves the field out
# and the server picks its own checkpoint.
# AMSHA_DECISION_KEV_ENABLED=false
# AMSHA_DECISION_KEV_ENDPOINT=http://127.0.0.1:8000/v1/systemone
# AMSHA_DECISION_KEV_MODEL=
# AMSHA_DECISION_KEV_API_KEY=
# AMSHA_DECISION_KEV_TIMEOUT=PT50S
# AMSHA_DECISION_KEV_WIRE_PROFILE=JSON_OBJECT
# AMSHA_DECISION_KEV_GOVERNANCE_DATA_LOCATION=
# AMSHA_DECISION_KEV_GOVERNANCE_RETENTION_WINDOW=PT0S
# AMSHA_DECISION_KEV_GOVERNANCE_ALLOW_TRAINING_USE=false
# AMSHA_DECISION_KEV_GOVERNANCE_TENANT_ISOLATION=true
# AMSHA_DECISION_KEV_GOVERNANCE_PROJECTION_ALLOW_LIST=
# AMSHA_DECISION_KEV_GOVERNANCE_COST_CEILING_PER_THOUSAND=

# --- OMLX host (local System One endpoint) ---
# OMLX 0.7.1.dev1 exposes POST /v1/systemone; the 0.7.0 probe returned 404.
# OMLX's OpenAI API expects Bearer auth while Amsha's loopback client sends
# X-Amsha-Loopback-Token, so verify authentication compatibility before enabling.
# AMSHA_DECISION_OMLX_ENABLED=false
# AMSHA_DECISION_OMLX_ENDPOINT=http://127.0.0.1:8000/v1/systemone
# AMSHA_DECISION_OMLX_MODEL=clef-flash-oQ4e
# AMSHA_DECISION_OMLX_API_KEY=
# AMSHA_DECISION_OMLX_TIMEOUT=PT50S
# AMSHA_DECISION_OMLX_WIRE_PROFILE=JSON_OBJECT
# AMSHA_DECISION_OMLX_GOVERNANCE_DATA_LOCATION=
# AMSHA_DECISION_OMLX_GOVERNANCE_RETENTION_WINDOW=PT0S
# AMSHA_DECISION_OMLX_GOVERNANCE_ALLOW_TRAINING_USE=false
# AMSHA_DECISION_OMLX_GOVERNANCE_TENANT_ISOLATION=true
# Tool-risk evidence requires camel-case requiredOperation in the selected provider's
# projection allow-list; the runner refuses before provider egress when it is absent.
# AMSHA_DECISION_OMLX_GOVERNANCE_PROJECTION_ALLOW_LIST=
# Project-author-approved for non-routing OMLX evaluation only (2026-10-18).
# Zero bounds provider inference spend; local compute is excluded. Production ratification is pending.
# Uncomment to reproduce the evaluation cost setting:
# AMSHA_DECISION_OMLX_GOVERNANCE_COST_CEILING_PER_THOUSAND=0

# Keys follow pattern: AMSHA_EMBEDDING_{PROVIDER}_{KEY}
# Providers listed in AMSHA_INFINITE_LOOP_EMBEDDING_PROVIDERS must have config here.

# --- Ollama Embedding ---
AMSHA_EMBEDDING_OLLAMA_MODEL=nomic-embed-text:v1.5
AMSHA_EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
# Set both values only after validating that another provider emits this exact vector space.
# AMSHA_EMBEDDING_OLLAMA_SPACE_ID=nomic-embed-text-v1.5
# AMSHA_EMBEDDING_OLLAMA_SPACE_REVISION=<immutable-model-revision>
# AMSHA_EMBEDDING_OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# --- Jina Embedding (uncomment to use) ---
# AMSHA_EMBEDDING_JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AMSHA_EMBEDDING_JINA_MODEL=jina-embeddings-v5-text-nano
# AMSHA_EMBEDDING_JINA_BASE_URL=https://api.jina.ai/v1/
# AMSHA_EMBEDDING_JINA_SPACE_ID=<verified-shared-space-id>
# AMSHA_EMBEDDING_JINA_SPACE_REVISION=<immutable-model-revision>

# --- OpenAI Embedding (uncomment to use) ---
# AMSHA_EMBEDDING_OPENAI_API_KEY=<openai-api-key>
# AMSHA_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# Set only when `onnx` is explicitly included in AMSHA_INFINITE_LOOP_EMBEDDING_PROVIDERS.
# It is the verified local bundle ID under AMSHA_ONNX_MODEL_ROOT, never a remote model URL.
# AMSHA_EMBEDDING_ONNX_MODEL=all-mpnet-base-v2-e8c3b32
# AMSHA_EMBEDDING_ONNX_TIMEOUT_SECONDS=5
# AMSHA_EMBEDDING_ONNX_SPACE_ID=sentence-transformers/all-mpnet-base-v2
# AMSHA_EMBEDDING_ONNX_SPACE_REVISION=e8c3b32edf5434bc2275fc9bab85f82640a19130
# Packaged binary (no mise required): ./amsha-sqlite models install mpnet
# Source checkout: mise run models:install-mpnet
# AMSHA_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1
# AMSHA_EMBEDDING_OPENAI_SPACE_ID=<verified-shared-space-id>
# AMSHA_EMBEDDING_OPENAI_SPACE_REVISION=<immutable-model-revision>


# Vector dimension - MUST match the model above.
# Mismatch causes silent vec_global insert failures.
#   nomic-embed-text:v1.5   → 768
#   mxbai-embed-large       → 1024
#   jina-embeddings-v5-text-small     → 1024
#   jina-embeddings-v5-text-nano      → 768
#   text-embedding-3-small  → 1536
# AMSHA_EMBED_DIMENSIONS=768


# -----------------------------------------------------------------------------
# RAG Native Extensions
# -----------------------------------------------------------------------------
# Path where the sqlite-vec extension is extracted from the binary on first boot.
# If you want to keep your root directory clean, point this to your data dir.
# Default: ./lib/vec0 (becomes ./lib/vec0.so or .dll)
# AMSHA_RAG_VEC_PATH=./lib/vec0
# Auto-download sqlite-vec (SHA-256 verified) when missing from disk and JAR.
# Default: false (offline-safe; enable on networked dev machines)
# AMSHA_RAG_VEC_AUTO_DOWNLOAD=false
# sqlite-vec version used by the auto-downloader. 0.1.9 digests are pinned in
# code; other versions are verified against the release checksums.txt.
# AMSHA_RAG_VEC_VERSION=0.1.9
# Enable local ONNX cross-encoder reranking (Issue 05). Defaults to false.
# AMSHA_RAG_RERANKER_ENABLED=false
# Bundle ID for local ONNX cross-encoder reranker.
# AMSHA_RAG_RERANKER_BUNDLE_ID=bge-reranker-v1
# Timeout for local ONNX cross-encoder reranking.
# AMSHA_RAG_RERANKER_TIMEOUT=PT5S
# Maximum candidates window evaluated by local ONNX reranker.
# AMSHA_RAG_RERANKER_MAX_CANDIDATES=50
# Maximum byte size for query/chunk texts passed to ONNX reranker.
# AMSHA_RAG_RERANKER_MAX_INPUT_BYTES=262144


# -----------------------------------------------------------------------------
# Chat Memory & Retention
# -----------------------------------------------------------------------------
# Maximum messages to keep in the active LLM sliding window.
# AMSHA_CHAT_MEMORY_MAX_MESSAGES=20

# Max chars kept when recovering a malformed final answer from tool output.
# AMSHA_CHAT_RECOVERED_OBSERVATION_MAX_CHARS=2000

# Number of days to retain chat history in SQLite.
# After this period, SessionReaper auto-purges old conversations.
AMSHA_CHAT_MEMORY_RETENTION_DAYS=30

# Number of days before inactive session catalog entries are archived.
# After this period, SessionReaper daily sweep archives them; archived sessions are read-only.
AMSHA_SESSION_CATALOG_ARCHIVE_AFTER_DAYS=90

# Execution Trace Persistence & Retention (Issue 08)
# Maximum capacity of the in-memory bounded queue before oldest events are dropped.
# AMSHA_TRACE_PERSISTENCE_QUEUE_CAPACITY=10000
# Number of days to retain durable execution traces before scheduled pruning.
# AMSHA_TRACE_RETENTION_MAX_AGE_DAYS=7
# Maximum number of runs retained per session before oldest runs are pruned.
# AMSHA_TRACE_RETENTION_MAX_RUNS_PER_SESSION=50
# Interval between scheduled trace retention pruning sweeps.
# AMSHA_TRACE_RETENTION_INTERVAL=24h

# -----------------------------------------------------------------------------
# Tiered Memory (MemGPT-Style) — all disabled by default
# -----------------------------------------------------------------------------
# Master switch for tiered memory features (Core, Recall, Archival).
AMSHA_MEMORY_TIERED_ENABLED=false
# Backend for tiered memory: sqlite | postgres | fs
# Must match AMSHA_PERSISTENCE_BACKEND when tiered memory is enabled.
AMSHA_MEMORY_TIERED_BACKEND=sqlite

# ── Core Memory ──
# Enable curated blocks rendered into system prompt.
AMSHA_MEMORY_CORE_ENABLED=false
# AMSHA_MEMORY_CORE_MAX_BLOCKS_PER_USER=20
# AMSHA_MEMORY_CORE_MAX_CHARS_PER_BLOCK=2000

# ── Recall Memory ──
# Enable FTS5 exact-history message persistence and search.
AMSHA_MEMORY_RECALL_ENABLED=false
# AMSHA_MEMORY_RECALL_RETENTION_DAYS=90
# AMSHA_MEMORY_RECALL_MAX_SEARCH_RESULTS=10
# AMSHA_MEMORY_RECALL_CROSS_SESSION=true

# ── Archival Memory ──
# Enable semantic long-term search via BM25 + vector hybrid.
AMSHA_MEMORY_ARCHIVAL_ENABLED=false
# AMSHA_MEMORY_ARCHIVAL_MAX_SEARCH_RESULTS=8
# AMSHA_MEMORY_ARCHIVAL_HYBRID_K=60
# AMSHA_MEMORY_ARCHIVAL_CONFIDENCE_THRESHOLD=0.6
# Eviction: auto-clean low-confidence chunks
# AMSHA_MEMORY_ARCHIVAL_LOW_CONFIDENCE_DAYS=60
# AMSHA_MEMORY_ARCHIVAL_LOW_CONFIDENCE_THRESHOLD=0.5
# AMSHA_MEMORY_ARCHIVAL_LRU_MIN_ACCESS_COUNT=1
# AMSHA_MEMORY_ARCHIVAL_LRU_MAX_AGE_DAYS=90

# ── Prompt Budget ──
# AMSHA_MEMORY_PROMPT_BUDGET_CORE_TOKENS=800
# AMSHA_MEMORY_PROMPT_BUDGET_COMPACTION_TOKENS=1200
# AMSHA_MEMORY_PROMPT_BUDGET_ARCHIVAL_RESULTS=3
# AMSHA_MEMORY_PROMPT_BUDGET_DIRECTIVES=5
# AMSHA_MEMORY_PROMPT_BUDGET_TOTAL_TOKENS=2500

# ── Memory Write Governance ──
# AMSHA_MEMORY_GOVERNANCE_CORE_WRITES_PER_MINUTE=5
# AMSHA_MEMORY_GOVERNANCE_ARCHIVAL_WRITES_PER_HOUR=10

# ── Memory Retention & Eviction ──
# AMSHA_MEMORY_RETENTION_ENABLED=true
# AMSHA_MEMORY_RETENTION_RECALL_RETENTION_DAYS=30
# AMSHA_MEMORY_RETENTION_ARCHIVAL_EVICTION_THRESHOLD=0.3
# AMSHA_MEMORY_RETENTION_ARCHIVAL_MIN_AGE_DAYS=30

# -----------------------------------------------------------------------------
# Self-Evolution (Hermes-Style) — disabled by default
# -----------------------------------------------------------------------------
AMSHA_SELF_EVOLVE_ENABLED=false
# AMSHA_SELF_EVOLVE_BACKEND=sqlite
# AMSHA_SELF_EVOLVE_BUFFER_SIZE=50
# AMSHA_SELF_EVOLVE_DEFAULT_SEARCH_LIMIT=8
# AMSHA_SELF_EVOLVE_DIRECTIVES_ENABLED=true
# Synthesis trigger: manual | cron (never "auto" in live path)
# AMSHA_SELF_EVOLVE_SYNTHESIS_TRIGGER=manual
# AMSHA_SELF_EVOLVE_FLUSH_MAX_EVENTS=12
# AMSHA_SELF_EVOLVE_FLUSH_IDLE_MS=300000

# -----------------------------------------------------------------------------
# Security & Governance
# -----------------------------------------------------------------------------
# Session Budget Limit (Prevents runaway costs, essential for free tier tracking)
AMSHA_BUDGET_LIMIT=999.0
AMSHA_BUDGET_ACTION=READONLY  # [BLOCK, READONLY]

# Maximum number of nested agent delegations allowed per session.
# Prevents infinite loops (e.g., Coordinator -> Architect -> Architect).
# Default 3 allows: coordinator → researcher → coder → researcher (for API research).
AMSHA_DELEGATION_MAX_DEPTH=3

# Tools that bypass HITL approval in SUPERVISED mode (comma-separated).
# garuda is NOT in the default list — role trust handles delegation governance.
# schedule_task removed per ADR-schedule-task-hitl-under-supervised (cron creation
# under SUPERVISED now requires approval); manage_schedule stays exempt.
# Default: manage_schedule
AMSHA_HITL_EXEMPT_TOOLS=manage_schedule

# Ops salvaged to a 409 pause-for-approval instead of a hard 403 under SUPERVISED.
# SCHEDULE_AUTONOMOUS added per ADR-schedule-task-hitl-under-supervised.
# Default: NETWORK_OUTBOUND,VAULT_ACCESS,EXECUTE_SHELL,WRITE_MEMORY,DELEGATE_AUTONOMOUS,WRITE_FS,SCHEDULE_AUTONOMOUS
AMSHA_SUPERVISED_SALVAGE_OPERATIONS=NETWORK_OUTBOUND,VAULT_ACCESS,EXECUTE_SHELL,WRITE_MEMORY,DELEGATE_AUTONOMOUS,WRITE_FS,SCHEDULE_AUTONOMOUS

# Approval lease for parallel batches (ADR-approval-lease-for-parallel-batches).
# Session-bound, in-memory, TTL-bounded; false restores strict re-prompting.
# Default: enabled=true, ttl-seconds=3600
AMSHA_HITL_APPROVAL_LEASE_ENABLED=true
AMSHA_HITL_APPROVAL_LEASE_TTL_SECONDS=3600

# Safety TTL for session resumption marks (in seconds). 
# Prevents a crashed resume from permanently locking a session.
# Default to (60 secs) 1 min
# Default: 300 (5 minutes) to accommodate long Playwright/search tasks.
AMSHA_RESUMPTION_STALE_MARK_SECONDS=60
AMSHA_TOOLS_PLAYWRIGHT_RESUMPTION_STALE_MARK_SECONDS=300

# Window for reclaiming stuck/orphaned IN_PROGRESS checkpoints (in minutes).
AMSHA_CHECKPOINT_STALE_CLAIM_MINUTES=2

# Master keys for encryption and audit integrity.
# Generate separate Base64 values for production: openssl rand -base64 32
AMSHA_VAULT_PEPPER=changeme-vault-pepper-key-min-32-bytes
AMSHA_AUDIT_HMAC_KEY=changeme-audit-hmac-key-min-32-bytes
AMSHA_AUTH_HMAC_KEY=changeme-auth-hmac-key-min-32-bytes
AMSHA_API_KEYS_INTERNAL=changeme-api-keys-internal-key-min-32-bytes
AMSHA_API_KEYS_CI=changeme-api-keys-ci-key-min-32-bytes

AMSHA_AUTH_SESSION_IDLE_MINUTES=720
AMSHA_AUTH_SESSION_ROTATION_GRACE_SECONDS=30


# Set to true to require Human-in-the-Loop approval for sensitive third-party SkillsJars capabilities
AMSHA_SKILLSJARS_REQUIRE_APPROVAL_FOR_SENSITIVE=true
AMSHA_SKILLS_ADAPTIVE_ENABLED=false
AMSHA_SKILLS_DEFAULT_MAX_ITERATIONS=15

# API request and mutation rate limits (requests per minute per API key).
# Defaults mirror application.yaml (6000/1000); lower them for exposed deployments.
AMSHA_API_RATE_LIMIT_REQUESTS_PER_MINUTE=6000
AMSHA_API_RATE_LIMIT_MUTATION_PER_MINUTE=1000

# -----------------------------------------------------------------------------
# External API Keys (Optional)
# -----------------------------------------------------------------------------
# Get one at: https://api-dashboard.search.brave.com/app/keys
# 2500 free calls at: https://serper.dev/dashboard
AMSHA_TOOLS_BRAVE_API_KEY=none
AMSHA_TOOLS_SERPER_API_KEY=none

# GitHub Integration
AMSHA_TOOLS_GITHUB_TOKEN=none
AMSHA_GITHUB_REPOS_PER_PAGE=100
# Optional selected-repository GitHub App for the owner-scoped README connector; replace none with the numeric App ID
AMSHA_GITHUB_APP_ID=none
# GitHub documentation indexing and prompt retrieval are disabled unless explicitly enabled.
AMSHA_GITHUB_DOCS_CONNECTOR_ENABLED=false
# Automatically connect and sync documentation for workspaces on startup when connector is enabled.
AMSHA_GITHUB_DOCS_AUTO_SYNC_ON_STARTUP=true

# JSON Salvage max lines
AMSHA_CORE_UTIL_JSON_SALVAGE_MAX_LINES=20

# Tool Playwright setup
AMSHA_TOOLS_PLAYWRIGHT_ENABLED=false
# Set false to run browser in headed mode (useful for debugging navigation issues)
AMSHA_TOOLS_PLAYWRIGHT_HEADLESS=true
# Set to true to skip automatic browser installation (useful for headless/constrained envs)
AMSHA_TOOLS_PLAYWRIGHT_SKIP_INSTALL=false
# Enable Playwright MCP Server mode (connects via @playwright/mcp STDIO, falls back to CLI)
AMSHA_TOOLS_PLAYWRIGHT_MCP_ENABLED=false
# Set to false to show browser window (for debugging)
AMSHA_TOOLS_PLAYWRIGHT_MCP_HEADLESS=true
# Command and args for the Playwright MCP Server
AMSHA_TOOLS_PLAYWRIGHT_MCP_COMMAND=npx
AMSHA_TOOLS_PLAYWRIGHT_MCP_ARGS=@playwright/mcp

# Outbound MCP Client / Server Bridge Settings
# Enable the outbound MCP connection REST API (connect to remote servers)
AMSHA_MCP_SERVER_ENABLED=true
AMSHA_MCP_SETUP_TOKEN_SECRET=
AMSHA_MCP_SETUP_UI_BASE_URL=http://localhost:8080
# How often to check health of active SSE/HTTP outbound MCP connections (ms)
AMSHA_MCP_HEALTH_CHECK_INTERVAL_MS=15000
# How often to check health of active Podman/Stdio outbound MCP connections (ms)
AMSHA_MCP_PODMAN_HEALTH_CHECK_INTERVAL_MS=15000

# LLM Resilience (Max retries and timeouts)
# Seed the stable audit HMAC key from this .env on the first boot of a new vault.
# Keep the generated AMSHA_AUDIT_HMAC_KEY unchanged across restarts. Set false only
# when the vault is already provisioned with that key; see docs/CONFIGURATION.md.
AMSHA_AUTO_SEED_SECRETS=true

# Toggle for full HTTP request/response logging for LLM providers.
# WARNING: Setting to true will leak API keys/tokens to the application logs.
AMSHA_LLM_LOG_HTTP=false
AMSHA_LLM_MAX_RETRIES=3
AMSHA_LLM_MAX_OUTPUT_TOKENS=8192
#AMSHA_LLM_MAX_OUTPUT_TOKENS=4096
# AMSHA_LLM_MAX_OUTPUT_TOKENS=1024

# Default timeout for LLM calls. 
# NVIDIA cold-start can take 60-90s on free tier - increase to PT120S if needed.
AMSHA_LLM_TIMEOUT=PT45S
# AMSHA_LLM_TIMEOUT=PT120S

# Schema self-correction retry budget per structured output mode
AMSHA_AGENT_SCHEMA_CORRECTION_MAX_RETRIES_STRICT=4
AMSHA_AGENT_SCHEMA_CORRECTION_MAX_RETRIES_LENIENT=6

# Max retries for LLM rate limits (TPM/RPM) before failing the iteration.
AMSHA_AGENT_MAX_RATELIMIT_RETRIES=3

# Rate limit auto-retry thresholds (seconds)
AMSHA_AGENT_RATE_LIMIT_MAX_AUTO_RETRY_SECONDS=15
AMSHA_AGENT_RATE_LIMIT_DEFAULT_RETRY_SECONDS=10

# Default delay for general rate limit retries
AMSHA_RETRY_DEFAULT_DELAY_MS=30000

# Audit engine idle timeout
AMSHA_AUDIT_IDLE_TIMEOUT_MS=10000

# Max backoff delay for memory compaction
AMSHA_MEMORY_COMPACTION_MAX_BACKOFF_MS=60000

# Timeout (seconds) to wait for in-flight compaction before proceeding with stale state.
# Free-tier models may need 60-90s. Default: 60.
AMSHA_COMPACTION_AWAIT_TIMEOUT_SECONDS=60

AMSHA_LLM_TEMPERATURE=0.1

# PII scanning mode: REDACT_AND_FORWARD | BLOCK_AND_NOTIFY
# AMSHA_PII_MODE=REDACT_AND_FORWARD


# -----------------------------------------------------------------------------
# Telegram Integration
# -----------------------------------------------------------------------------

AMSHA_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmNOPQrsTUVwxyz

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Find your ID: message @userinfobot on Telegram.
AMSHA_TELEGRAM_ALLOWED_USER_IDS=<telegram-user-ids-comma-seperated>


# Comma-separated Telegram usernames (without @) - optional, IDs take priority.
AMSHA_TELEGRAM_ALLOWED_USERS=<telegram-user-name>

# Telegram message length
AMSHA_CHANNEL_TELEGRAM_MAX_LENGTH=4096

# Telegram Bot API base URI (default: https://api.telegram.org)
AMSHA_TELEGRAM_BASE_URI=https://api.telegram.org

# -----------------------------------------------------------------------------
# Web Chat Integration
# -----------------------------------------------------------------------------
AMSHA_WEB_ENABLED=true
AMSHA_WEB_REQUIRE_AUTH=false

# -----------------------------------------------------------------------------
# Scheduling & Timezones
# -----------------------------------------------------------------------------
# The default IANA timezone used for relative time scheduling ("in 5 minutes")
# and prompt rendering. Overridden by user-specific metadata when available.
# Valid values: Asia/Kolkata, America/New_York, UTC, etc.
AMSHA_DEFAULT_TIMEZONE=Asia/Kolkata

# Cron startup delay
AMSHA_CRON_STARTUP_DELAY_MS=5000


# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# OTLP endpoint for traces. Use local Jaeger or managed provider.
# Docker compose: http://otel-collector:4317
# Local Jaeger:   http://localhost:4317
# QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true

# LangChain4j ChatModelListener migration pilot (off | shadow | active)
AMSHA_OBSERVABILITY_CHAT_LISTENER_MODE=off

# Phoenix integration for OpenInference tracing and LLM debugging
AMSHA_PHOENIX_ENABLED=true
AMSHA_PHOENIX_ENDPOINT=http://localhost:4318/v1/traces


# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
# Options: PODMAN (recommended) | NAMESPACE (Linux only) | DIRECT (insecure)
AMSHA_SANDBOX_STRATEGY=PODMAN
AMSHA_SANDBOX_ENABLED=true
# Optional container image override (takes precedence over AMSHA_SANDBOX_PODMAN_IMAGE)
# AMSHA_SANDBOX_IMAGE=localhost/amsha-tool-runner:latest
AMSHA_SANDBOX_PODMAN_IMAGE=localhost/amsha-tool-runner:latest

# [PODMAN-SPECIFIC] Change to 'bridge' or 'slirp4netns' if 'host' is restricted.
# 'host' is now the default to ensure tools (like GitHub) work out-of-the-box.
AMSHA_SANDBOX_NETWORK=host

# [PODMAN-SPECIFIC] Transport mechanism for passing secrets into the container.
# options: 
#   - tmpfs:  Uses /run/amsha/secrets (Linux production only)
#   - tmpdir: Uses OS temp directory (macOS/Windows/Dev)
#   - <path>: Explicit literal path to use for secret files
# Auto-detects based on OS if unset. Defaults to tmpdir on macOS/Windows.
# AMSHA_SANDBOX_SECRET_TRANSPORT=tmpfs

# [PODMAN-SPECIFIC] The UID:GID to run as inside the container. 65534=nobody.
AMSHA_SANDBOX_USER=sandbox

# Resource Limits
AMSHA_SANDBOX_MEMORY_LIMIT=512m
AMSHA_SANDBOX_CPU_LIMIT=0.5
AMSHA_SANDBOX_MAX_OUTPUT_CHARS=8192

# Container Execution Timeouts (in seconds)
AMSHA_SANDBOX_TIMEOUT_SECONDS=30
AMSHA_SANDBOX_NETWORK_TIMEOUT_SECONDS=60

# Circuit Breaker
# AMSHA_SANDBOX_CB_FAILURE_THRESHOLD=3
# AMSHA_SANDBOX_CB_RESET_TIMEOUT_SECONDS=30

# Paths
# AMSHA_SANDBOX_PODMAN_PATH=podman

# Executable overrides (Optional: overrides PATH discovery for host/sandbox execution)
# AMSHA_SANDBOX_PYTHON_EXECUTABLE=/usr/bin/python3
# AMSHA_SANDBOX_GO_EXECUTABLE=/opt/homebrew/bin/go
# AMSHA_SANDBOX_JAVA_EXECUTABLE=/opt/homebrew/bin/java

# Host Execution Settings (Dedicated host execution overrides)
# AMSHA_HOST_EXEC_MAX_OUTPUT_CHARS=131072
# AMSHA_HOST_EXEC_PYTHON_EXECUTABLE=/usr/bin/python3
# AMSHA_HOST_EXEC_GO_EXECUTABLE=/opt/homebrew/bin/go
# AMSHA_HOST_EXEC_JAVA_EXECUTABLE=/opt/homebrew/bin/java


# Fallback to host execution if Podman image is missing or daemon is offline.
# WARNING: Setting this to true reduces security isolation.
AMSHA_SANDBOX_ALLOW_INSECURE_FALLBACK=true

# Direct-host execution for diagnostic skills that cannot work inside the Podman
# sandbox (e.g. JDB attaching to host JVMs). Comma-separated skill names.
# Each listed skill receives the host_exec tool capability at startup.
# host_exec still requires HITL approval on every invocation.
# AMSHA_TOOLS_HOST_EXEC_SKILLS=algorithmic-art

# Password for 7z archives. Leave empty to disable.
# AMSHA_7Z_PASS=

# -----------------------------------------------------------------------------
# SonarQube Integration (Optional)
# -----------------------------------------------------------------------------
# SonarQube API token for code analysis.
# Generate at: http://localhost:9000 → My Account → Security → Generate Tokens
# Required permission: "Execute Analysis"
# SONAR_TOKEN=sqp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SonarQube server URL (default: local SonarQube instance)
# SONAR_API_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# OIDC / GitHub OAuth Authentication
# -----------------------------------------------------------------------------
# OIDC configuration options
# AMSHA_AUTH_IDP_OIDC_ENABLED=false
# AMSHA_AUTH_IDP_OIDC_CLIENT_ID=your-oidc-client-id
# AMSHA_AUTH_IDP_OIDC_CLIENT_SECRET=your-oidc-client-secret
# AMSHA_AUTH_IDP_OIDC_CLIENT_SECRET_VAULT_KEY=oidc-client-secret   # preferred over plaintext client-secret
# AMSHA_AUTH_IDP_OIDC_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# AMSHA_AUTH_IDP_OIDC_TOKEN_URL=https://oauth2.googleapis.com/token
# AMSHA_AUTH_IDP_OIDC_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# AMSHA_AUTH_IDP_OIDC_ISSUER=https://accounts.google.com
# AMSHA_AUTH_IDP_OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# AMSHA_AUTH_IDP_OIDC_REDIRECT_URI=https://your-host/api/v1/auth/callback/oidc   # fixed, pre-registered redirect

# GitHub OAuth configuration options
# AMSHA_AUTH_IDP_GITHUB_ENABLED=false
# AMSHA_AUTH_IDP_GITHUB_CLIENT_ID=your-github-client-id
# AMSHA_AUTH_IDP_GITHUB_CLIENT_SECRET=your-github-client-secret
# AMSHA_AUTH_IDP_GITHUB_REDIRECT_URI=https://your-host/api/v1/auth/callback/github

# -----------------------------------------------------------------------------
# Media Ingestion & Download Limits (Multimodal)
# -----------------------------------------------------------------------------
# Maximum size in megabytes for single image attachments (default: 10)
# AMSHA_MEDIA_MAX_IMAGE_SIZE_MB=10
# Maximum size in megabytes for single document/audio attachments (default: 25)
# AMSHA_MEDIA_MAX_DOCUMENT_SIZE_MB=25
# Maximum total payload in megabytes across all attachments in a single turn (default: 50)
# AMSHA_MEDIA_MAX_TOTAL_PAYLOAD_MB=50
# Governed HTTP connect timeout in seconds for media downloads (default: 10)
# AMSHA_MEDIA_CONNECT_TIMEOUT_SECONDS=10
# Governed HTTP read timeout in seconds for media downloads (default: 30)
# AMSHA_MEDIA_READ_TIMEOUT_SECONDS=30
