AMSHA_COMPACTION_CODEX_MODEL=gpt-5.6-luna
AMSHA_COMPACTION_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex

# --- Claude Code Compaction (uncomment to use) ---
