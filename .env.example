# =============================================================================
# Amsha Agent - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your specific values.
# DO NOT commit the real '.env' file to version control.
#
# Quick-start defaults are provided where possible. Required fields are
# marked with [REQUIRED] - the app will not start without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime Profile
# -----------------------------------------------------------------------------
# Quarkus profile: prod | dev | test
QUARKUS_PROFILE=prod


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Directory where Amsha Agent stores its SQLite databases and state files.
# Docker:  leave as ./data (volume-mounted at /app/data)
# Windows: use forward slashes or set to C:/Users/<user>/amsha-data
AMSHA_DATA_DIR=./data

# Persistence backend selection: sqlite (default) | postgres | fs
# Controls @IfBuildProperty — evaluated at BUILD TIME, not just runtime.
# For SQLite (default): leave unset or comment out (enableIfMissing=true activates it).
# For PostgreSQL: set to "postgres" and use -Dquarkus.profile=cli,postgresql
# For Filesystem: set to "fs" and also set QUARKUS_FLYWAY_ENABLED=false below
# IMPORTANT: Rebuild the app after changing: ./mvnw clean package -pl app -DskipTests
# AMSHA_PERSISTENCE_BACKEND=sqlite

# Flyway (SQL migrations) — must be disabled for filesystem backend.
# Set to "false" when AMSHA_PERSISTENCE_BACKEND=fs
# QUARKUS_FLYWAY_ENABLED=true

# PostgreSQL backend (uncomment and fill in when using %postgresql profile)
# See app/src/main/resources/application.yaml for switching instructions.
# AMSHA_PG_HOST=localhost
# AMSHA_PG_PORT=5432
# AMSHA_PG_DB=amsha
# AMSHA_PG_USER=amsha
# AMSHA_PG_PASSWORD=changeme

# Flyway clean-on-start (dev profile only). Controls whether the database is
# wiped on each restart. Default is true (fresh schema every restart).
# Set to false to persist data across dev restarts.
# AMSHA_FLYWAY_CLEAN_AT_START=true

# Filesystem backend (uncomment when using %filesystem profile)
# AMSHA_FS_DATA_DIR=./data/fs
# AMSHA_FS_LUCENE_INDEX_DIR=lucene-index
# AMSHA_FS_VECTOR_DIMENSION=768


# -----------------------------------------------------------------------------
# HTTP / CORS
# -----------------------------------------------------------------------------
# Allowed CORS origins. Comma-separated for multiple.
AMSHA_CORS_ORIGINS=http://localhost:3000


# LLM Providers: groq | gemini | openrouter | ollama | openai | omlx | nvidia | cerebras | generic-openai | infinite-loop
# AMSHA_LLM_PROVIDER=groq
# AMSHA_LLM_PROVIDER=gemini
# AMSHA_LLM_PROVIDER=openrouter
# AMSHA_LLM_PROVIDER=ollama
# AMSHA_LLM_PROVIDER=openai
# AMSHA_LLM_PROVIDER=omlx
# AMSHA_LLM_PROVIDER=nvidia
# AMSHA_LLM_PROVIDER=cerebras
# AMSHA_LLM_PROVIDER=generic-openai
AMSHA_LLM_PROVIDER=infinite-loop
# LLM model override (optional, used when provider is not infinite-loop)
# AMSHA_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ── Vault Priority ──
# When true: the onboarding UI's provider/model/key in the vault takes priority
# over the .env config. When false (default): .env config is always used
# (recommended for infinite-loop power users who bypass the UI onboarding).
AMSHA_LLM_VAULT_PRIORITY=false

# ── Infinite Loop: Multi-provider round-robin with infinite fallback ──
# Set AMSHA_LLM_PROVIDER=infinite-loop to activate.
# On failure/rate-limit, the next provider is tried in round-robin order.
# After the last provider, loops back to the first (never-ending).
# Only fails when ALL providers have permanent auth errors.
#
# Multi-key/model support: comma-separate API keys and/or model names.
# On rate limit, rotates to the next key within the same provider slot
# before moving to a different provider. Examples:
#   AMSHA_GROQ_API_KEY=key1,key2,key3    (3 keys, same model)
#   AMSHA_GROQ_MODEL=model-a,model-b     (1 key, 2 models)
#   AMSHA_GROQ_API_KEY=k1,k2             (paired by index with models)
# AMSHA_INFINITE_LOOP_LLM_PROVIDERS=llamacpp,ollama,omlx,groq,openrouter,nvidia,cerebras,gemini,generic-openai
AMSHA_INFINITE_LOOP_LLM_PROVIDERS=groq,openrouter,nvidia,generic-openai
AMSHA_INFINITE_LOOP_COOLDOWN_BASE_SECONDS=30
AMSHA_INFINITE_LOOP_COOLDOWN_MAX_SECONDS=300
AMSHA_INFINITE_LOOP_COOLDOWN_TRANSIENT_SECONDS=5

# -----------------------------------------------------------------------------
# Per-Persona / Per-Group Model Routing (P102)
# -----------------------------------------------------------------------------
# Override the default LLM model per agent persona or group (Loka).
# Resolution: persona override → group default → global default.
#
# Single model (env var):
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_PROVIDER=deepseek
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_MODEL=deepseek-coder-33b
#
# Group default (env var):
#   AMSHA_LLM_GROUP_MODELS_KAILASA_PROVIDER=groq
#   AMSHA_LLM_GROUP_MODELS_KAILASA_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# Multi-model failover (numbered):
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_PROVIDER=deepseek
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_MODEL=deepseek-coder-33b
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_PROVIDER=groq
#   AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_MODEL=llama-3.3-70b
#
# Also configurable via YAML (application.yaml) under amsha.llm.persona.models.
#
# Circuit breaker per-model isolation is automatic.
# A failure in one provider (e.g. Groq rate-limit) will NOT trip
# the circuit for other providers (e.g. OpenAI, Gemini).
AMSHA_LLM_CIRCUIT_BREAKER_ENABLED=true

# --- Group/Persona Model Overrides for Connectivity testing ---
# AMSHA_LLM_GROUP_MODELS_KAILASA_PROVIDER=groq
# AMSHA_LLM_GROUP_MODELS_KAILASA_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Multi-model failover test for Brahma persona (deity/alias name for Coder)
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_PROVIDER=generic-openai
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_0_MODEL=non-existent-failover-model
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_PROVIDER=groq
# AMSHA_LLM_PERSONA_MODELS_BRAHMA_1_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AMSHA_LLM_PERSONA_MODELS_RESEARCHER_PROVIDER=cerebras
# AMSHA_LLM_PERSONA_MODELS_RESEARCHER_MODEL=gpt-oss-120b


# ── Headroom: LLM Context Compression Proxy ──
# Headroom sits between Amsha Agent and remote LLM providers to compress
# context windows using semantic layers, reducing token costs by 30-60%.
# Set AMSHA_HEADROOM_ENABLED=true to route ALL providers through Headroom.
# After changing this, restart Amsha Agent for the change to take effect.
#
# Headroom proxies auto-start via:  mise run headroom:start-all
# and auto-stop via:               mise run headroom:stop-all
#
# Requirements: uv (https://github.com/astral-sh/uv) must be installed.
#
# Port map (remote providers first, local providers last):
#   openrouter  → http://localhost:8788/v1
#   groq        → http://localhost:8789/v1
#   nvidia      → http://localhost:8790/v1
#   cerebras    → http://localhost:8791/v1
#   gemini      → http://localhost:8792/v1  (uses --backend gemini)
#   openai      → http://localhost:8793/v1
#   ollama      → http://localhost:8794/v1
#   omlx        → http://localhost:8795/v1
#   generic-openai → http://localhost:8796/v1
#   llamacpp    → http://localhost:8797/v1
#
# To enable: set AMSHA_HEADROOM_ENABLED=true and uncomment the proxy
# BASE_URL lines on your provider configs below.
AMSHA_HEADROOM_ENABLED=false

# Headroom proxy ports (auto-managed by mise run headroom:start-all):
#AMSHA_HEADROOM_OPENROUTER_PORT=8788
#AMSHA_HEADROOM_GROQ_PORT=8789
#AMSHA_HEADROOM_NVIDIA_PORT=8790
#AMSHA_HEADROOM_CEREBRAS_PORT=8791
#AMSHA_HEADROOM_GEMINI_PORT=8792
#AMSHA_HEADROOM_OPENAI_PORT=8793
#AMSHA_HEADROOM_OLLAMA_PORT=8794
#AMSHA_HEADROOM_OMLX_PORT=8795
#AMSHA_HEADROOM_GENERIC_OPENAI_PORT=8796
#AMSHA_HEADROOM_LLAMACPP_PORT=8797

# Headroom launcher tuning (used by .mise/tasks/headroom/*.ps1)
# Pin the uvx package version. Scripts default to 0.25.0 if unset.
#HEADROOM_VERSION=0.25.0
# Override the memory embedder runtime. On Apple Silicon this auto-defaults to
# pytorch_mps; set to empty to disable, or set another value to force it.
#HEADROOM_EMBEDDER_RUNTIME=pytorch_mps


# Max latency before a slow provider is treated as failure and the loop switches (ms).
# NVIDIA cold-start on free tier can take 60-90s — increase to 120000 if needed.
AMSHA_INFINITE_LOOP_MAX_LATENCY_MS=60000

# Infinite-loop provider lists per concern (independent of each other).
AMSHA_INFINITE_LOOP_COMPACTION_PROVIDERS=groq,ollama
AMSHA_INFINITE_LOOP_CLASSIFIER_PROVIDERS=groq,ollama
AMSHA_INFINITE_LOOP_EMBEDDING_PROVIDERS=ollama

# ── Test Mode: Force error instead of dummy fallback ──
# When running in test profile (e.g., `mvnw test`), infinite-loop providers
# inject dummy fallbacks (static "Dummy response") if all slots fail.
# Set to `true` to force real error paths instead of dummy fallbacks.
# Useful for testing error-handling logic explicitly.
# (System property: -Damsha.test.force-error=true)
# amsha.test.force-error=false


# -----------------------------------------------------------------------------
# Per-Provider API Keys & Config
# -----------------------------------------------------------------------------
# Each provider has its own dedicated env var. No shared keys.
# Default infinite-loop uses: omlx, groq, openrouter.
# Uncommented lines below are the default loop — override <...> placeholders.
# For other providers, uncomment and configure as needed.

# --- Groq ---
# Multi-key: comma-separated API keys rotate on rate limit (key1,key2,key3)
# Multi-model: comma-separated models rotate on failure (model-a,model-b)
AMSHA_GROQ_API_KEY=<groq-api-key-1>,<groq-api-key-2>
# AMSHA_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AMSHA_GROQ_BASE_URL=http://localhost:8789/v1  # via Headroom proxy
AMSHA_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# AMSHA_GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b,llama-3.3-70b-versatile

# --- Gemini ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_GEMINI_API_KEY=<gemini-api-key-1>,<gemini-api-key-2>
AMSHA_GEMINI_MODEL=gemini-2.5-flash-lite,gemini-2.0-flash-lite

# --- OpenRouter ---
# Multi-key: comma-separated API keys rotate on rate limit
AMSHA_OPENROUTER_API_KEY=sk-or-<your-key-1>,sk-or-<your-key-2>
# AMSHA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AMSHA_OPENROUTER_BASE_URL=http://localhost:8788/v1  # via Headroom proxy
AMSHA_OPENROUTER_MODEL=openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free

# --- NVIDIA ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_NVIDIA_API_KEY=nvapi-<your-key-1>,nvapi-<your-key-2>
# AMSHA_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AMSHA_NVIDIA_BASE_URL=http://localhost:8790/v1  # via Headroom proxy
# AMSHA_NVIDIA_MODEL=meta/llama-3.1-8b-instruct,microsoft/phi-4-multimodal-instruct

# --- Cerebras ---
# Multi-key: comma-separated API keys rotate on rate limit
# AMSHA_CEREBRAS_API_KEY=csk-<your-key-1>,csk-<your-key-2>
# AMSHA_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# AMSHA_CEREBRAS_BASE_URL=http://localhost:8791/v1  # via Headroom proxy
# Only qwen-3-235b for agent loop (llama3.1-8b has 8192 context — too small)
# AMSHA_CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

# --- OpenAI ---
# AMSHA_OPENAI_API_KEY=sk-<your-key>
# AMSHA_OPENAI_BASE_URL=https://api.openai.com/v1
# AMSHA_OPENAI_BASE_URL=http://localhost:8793/v1  # via Headroom proxy
# AMSHA_OPENAI_MODEL=gpt-4o,gpt-4o-mini

# --- Generic OpenAI-compatible (any endpoint) ---
# DeepSeek v4/r1 models auto-disable thinking mode to avoid "reasoning_content must be passed back" errors
# Extra body params: JSON object injected into the OpenAI request body (overrides auto-detect)
# AMSHA_GENERIC_OPENAI_EXTRA_BODY={"thinking": {"type": "disabled"}}
# AMSHA_GENERIC_OPENAI_API_KEY=sk-<your-key>
# AMSHA_GENERIC_OPENAI_MODEL=deepseek-v4-flash
# AMSHA_GENERIC_OPENAI_BASE_URL=https://api.example.com/v1
# AMSHA_GENERIC_OPENAI_BASE_URL=http://localhost:8796/v1  # via Headroom proxy
# AMSHA_GENERIC_OPENAI_TARGET_URL=https://api.example.com/v1

# --- OMLX (local, multi-model rotation) ---
# AMSHA_OMLX_API_KEY=needed
# AMSHA_OMLX_BASE_URL=http://127.0.0.1:8000/v1
# AMSHA_OMLX_BASE_URL=http://localhost:8795/v1  # via Headroom proxy
# Multi-model: comma-separated local models rotate on failure
# Removed: GLM-4.7-Flash (246s), MiMo-V2.5-ASR (server error)
# AMSHA_OMLX_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit,mlx-community/gemma-4-26b-a4b-it-4bit

# -----------------------------------------------------------------------------
# llama.cpp local inference server (OpenAI-compatible API).
# Start: ./server -m model.gguf --port 9000
# AMSHA_LLAMACPP_BASE_URL=http://localhost:9000/v1
# AMSHA_LLAMACPP_BASE_URL=http://localhost:8797/v1  # via Headroom proxy
# AMSHA_LLAMACPP_MODEL=qwen3

# -----------------------------------------------------------------------------
# LLM - Ollama (local, shared by chat + embeddings)
# -----------------------------------------------------------------------------
# Base URL for the local Ollama instance.
# Docker:  http://ollama:11434  (service name on compose network)
# Local:   http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# Chat model loaded into Ollama (used only if switching away from Groq).
# OLLAMA_MODEL=mistral-small:latest


# Manually force 'Compact Prompt Mode' (condensed security and architectural rules).
# Defaults to true if AMSHA_LLM_CONTEXT_WINDOW <= 8192.
AMSHA_LLM_COMPACT_PROMPT_ENABLED=true

# Strategy for ensuring structured output (JSON schema compliance).
# Modes: NATIVE (default), PROMPT_DIRECTIVE (forced JSON-only instructions), LENIENT.
# Auto-set by bootstrap: PROMPT_DIRECTIVE for llama-4-scout, NATIVE for others.
# AMSHA_LLM_STRUCTURED_OUTPUT_MODE=NATIVE
# AMSHA_LLM_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE
# AMSHA_INTENT_CLASSIFIER_STRUCTURED_OUTPUT_MODE=NATIVE
# AMSHA_INTENT_CLASSIFIER_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE
# AMSHA_COMPACTION_STRUCTURED_OUTPUT_MODE=NATIVE
# AMSHA_COMPACTION_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE


# Enable Ollama fallback for intent classification (default: false).
# When disabled, intent classifier failures fallback immediately to local heuristics.
# AMSHA_INTENT_CLASSIFIER_OLLAMA_FALLBACK_ENABLED=false


# Context window size (in tokens). 
# Triggered 'Compact Prompt Mode' if <= 8192 to fit within small windows.
# Auto-set by bootstrap: 8192 (Cerebras-Llama/Ollama), 64k (Cerebras-Qwen), 1M (Gemini), 128k (Others)
# AMSHA_LLM_CONTEXT_WINDOW=1000000
# AMSHA_LLM_CONTEXT_WINDOW=128000
# AMSHA_LLM_CONTEXT_WINDOW=8192


# -----------------------------------------------------------------------------
# Compaction Provider Config (per-provider keys)
# -----------------------------------------------------------------------------
# Keys follow pattern: AMSHA_COMPACTION_{PROVIDER}_{KEY}
# Providers listed in AMSHA_INFINITE_LOOP_COMPACTION_PROVIDERS must have config here.

# --- Groq Compaction ---
# Set PROMPT_DIRECTIVE if Groq hits: "json mode cannot be combined with tool/function calling"
AMSHA_COMPACTION_GROQ_API_KEY=<compaction-groq-api-key>
AMSHA_COMPACTION_GROQ_MODEL=llama-3.1-8b-instant
AMSHA_COMPACTION_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AMSHA_COMPACTION_GROQ_BASE_URL=http://localhost:8789/v1  # via Headroom proxy
# AMSHA_COMPACTION_GROQ_MAX_RETRIES=3

# --- Ollama Compaction ---
AMSHA_COMPACTION_OLLAMA_MODEL=mistral-small:latest
AMSHA_COMPACTION_OLLAMA_BASE_URL=http://localhost:11434
# AMSHA_COMPACTION_OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# --- Cerebras Compaction (uncomment to use) ---
# AMSHA_COMPACTION_CEREBRAS_API_KEY=<compaction-cerebras-api-key>
# AMSHA_COMPACTION_CEREBRAS_MODEL=llama3.1-8b
# AMSHA_COMPACTION_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- OpenRouter Compaction (uncomment to use) ---
# AMSHA_COMPACTION_OPENROUTER_API_KEY=<compaction-openrouter-api-key>
# AMSHA_COMPACTION_OPENROUTER_MODEL=openai/gpt-oss-20b:free
# AMSHA_COMPACTION_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Generic OpenAI Compaction (uncomment to use) ---
# Set PROMPT_DIRECTIVE if provider hits: "json mode cannot be combined with tool/function calling"
# AMSHA_COMPACTION_STRUCTURED_OUTPUT_MODE=PROMPT_DIRECTIVE
# AMSHA_COMPACTION_GENERIC_OPENAI_API_KEY=<compaction-generic-openai-api-key>
# AMSHA_COMPACTION_GENERIC_OPENAI_MODEL=deepseek-v4-flash
# AMSHA_COMPACTION_GENERIC_OPENAI_BASE_URL=https://api.example.com/v1
# AMSHA_COMPACTION_GENERIC_OPENAI_BASE_URL=http://localhost:8796/v1  # via Headroom proxy

# -----------------------------------------------------------------------------
# Classifier Provider Config (per-provider keys)
# -----------------------------------------------------------------------------
# Keys follow pattern: AMSHA_CLASSIFIER_{PROVIDER}_{KEY}
# Providers listed in AMSHA_INFINITE_LOOP_CLASSIFIER_PROVIDERS must have config here.

# --- Groq Classifier ---
AMSHA_CLASSIFIER_GROQ_API_KEY=<classifier-groq-api-key>
AMSHA_CLASSIFIER_GROQ_MODEL=llama-3.1-8b-instant
AMSHA_CLASSIFIER_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AMSHA_CLASSIFIER_GROQ_BASE_URL=http://localhost:8789/v1  # via Headroom proxy
# AMSHA_CLASSIFIER_GROQ_MAX_RETRIES=3

# --- Ollama Classifier ---
AMSHA_CLASSIFIER_OLLAMA_MODEL=mistral-small:latest
AMSHA_CLASSIFIER_OLLAMA_BASE_URL=http://localhost:11434
# AMSHA_CLASSIFIER_OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# --- Cerebras Classifier (uncomment to use) ---
# AMSHA_CLASSIFIER_CEREBRAS_API_KEY=<classifier-cerebras-api-key>
# AMSHA_CLASSIFIER_CEREBRAS_MODEL=llama3.1-8b
# AMSHA_CLASSIFIER_CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# --- OpenRouter Classifier (uncomment to use) ---
# AMSHA_CLASSIFIER_OPENROUTER_API_KEY=<classifier-openrouter-api-key>
# AMSHA_CLASSIFIER_OPENROUTER_MODEL=openai/gpt-oss-20b:free
# AMSHA_CLASSIFIER_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Generic OpenAI Classifier (uncomment to use) ---
# AMSHA_CLASSIFIER_GENERIC_OPENAI_API_KEY=<classifier-generic-openai-api-key>
# AMSHA_CLASSIFIER_GENERIC_OPENAI_MODEL=deepseek-v4-flash
# AMSHA_CLASSIFIER_GENERIC_OPENAI_BASE_URL=https://api.example.com/v1
# AMSHA_CLASSIFIER_GENERIC_OPENAI_BASE_URL=http://localhost:8796/v1  # via Headroom proxy

# -----------------------------------------------------------------------------
# Embedding Provider Config (per-provider keys)
# -----------------------------------------------------------------------------
# Keys follow pattern: AMSHA_EMBEDDING_{PROVIDER}_{KEY}
# Providers listed in AMSHA_INFINITE_LOOP_EMBEDDING_PROVIDERS must have config here.

# --- Ollama Embedding ---
AMSHA_EMBEDDING_OLLAMA_MODEL=nomic-embed-text:v1.5
AMSHA_EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
# AMSHA_EMBEDDING_OLLAMA_BASE_URL=http://localhost:8794/v1  # via Headroom proxy

# --- Jina Embedding (uncomment to use) ---
# AMSHA_EMBEDDING_JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AMSHA_EMBEDDING_JINA_MODEL=jina-embeddings-v5-text-nano
# AMSHA_EMBEDDING_JINA_BASE_URL=https://api.jina.ai/v1/

# --- OpenAI Embedding (uncomment to use) ---
# AMSHA_EMBEDDING_OPENAI_API_KEY=<openai-api-key>
# AMSHA_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# AMSHA_EMBEDDING_OPENAI_BASE_URL=https://api.openai.com/v1


# Vector dimension - MUST match the model above.
# Mismatch causes silent vec_global insert failures.
#   nomic-embed-text:v1.5   → 768
#   mxbai-embed-large       → 1024
#   jina-embeddings-v5-text-small     → 1024
#   jina-embeddings-v5-text-nano      → 768
#   text-embedding-3-small  → 1536
# AMSHA_EMBED_DIMENSIONS=768


# -----------------------------------------------------------------------------
# RAG Native Extensions
# -----------------------------------------------------------------------------
# Path where the sqlite-vec extension is extracted from the binary on first boot.
# If you want to keep your root directory clean, point this to your data dir.
# Default: ./lib/vec0 (becomes ./lib/vec0.so or .dll)
# AMSHA_RAG_VEC_PATH=./lib/vec0


# -----------------------------------------------------------------------------
# Chat Memory & Retention
# -----------------------------------------------------------------------------
# Maximum messages to keep in the active LLM sliding window.
# AMSHA_CHAT_MEMORY_MAX_MESSAGES=20

# Number of days to retain chat history in SQLite.
# After this period, SessionReaper auto-purges old conversations.
AMSHA_CHAT_MEMORY_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Tiered Memory (MemGPT-Style) — Phase 0: all disabled by default
# -----------------------------------------------------------------------------
# Master switch for tiered memory features (Core, Recall, Archival).
AMSHA_MEMORY_TIERED_ENABLED=false
# Backend for tiered memory: sqlite | postgres | fs
# Must match AMSHA_PERSISTENCE_BACKEND when tiered memory is enabled.
AMSHA_MEMORY_TIERED_BACKEND=sqlite

# ── Core Memory (Phase 1) ──
# Enable curated blocks rendered into system prompt.
AMSHA_MEMORY_CORE_ENABLED=false
# AMSHA_MEMORY_CORE_MAX_BLOCKS_PER_USER=20
# AMSHA_MEMORY_CORE_MAX_CHARS_PER_BLOCK=2000

# ── Recall Memory (Phase 2-3) ──
# Enable FTS5 exact-history message persistence and search.
AMSHA_MEMORY_RECALL_ENABLED=false
# AMSHA_MEMORY_RECALL_RETENTION_DAYS=90
# AMSHA_MEMORY_RECALL_MAX_SEARCH_RESULTS=10
# AMSHA_MEMORY_RECALL_CROSS_SESSION=true

# ── Archival Memory (Phase 5-6) ──
# Enable semantic long-term search via BM25 + vector hybrid.
AMSHA_MEMORY_ARCHIVAL_ENABLED=false
# AMSHA_MEMORY_ARCHIVAL_MAX_SEARCH_RESULTS=8
# AMSHA_MEMORY_ARCHIVAL_HYBRID_K=60
# AMSHA_MEMORY_ARCHIVAL_CONFIDENCE_THRESHOLD=0.6
# Eviction: auto-clean low-confidence chunks
# AMSHA_MEMORY_ARCHIVAL_LOW_CONFIDENCE_DAYS=60
# AMSHA_MEMORY_ARCHIVAL_LOW_CONFIDENCE_THRESHOLD=0.5
# AMSHA_MEMORY_ARCHIVAL_LRU_MIN_ACCESS_COUNT=1
# AMSHA_MEMORY_ARCHIVAL_LRU_MAX_AGE_DAYS=90

# ── Prompt Budget (Phase 4) ──
# AMSHA_MEMORY_PROMPT_BUDGET_CORE_TOKENS=800
# AMSHA_MEMORY_PROMPT_BUDGET_COMPACTION_TOKENS=1200
# AMSHA_MEMORY_PROMPT_BUDGET_ARCHIVAL_RESULTS=3
# AMSHA_MEMORY_PROMPT_BUDGET_DIRECTIVES=5
# AMSHA_MEMORY_PROMPT_BUDGET_TOTAL_TOKENS=2500

# ── Memory Write Governance (Phase 7) ──
# AMSHA_MEMORY_GOVERNANCE_CORE_WRITES_PER_MINUTE=5
# AMSHA_MEMORY_GOVERNANCE_ARCHIVAL_WRITES_PER_HOUR=10

# ── Memory Retention & Eviction (Phase 12) ──
# AMSHA_MEMORY_RETENTION_ENABLED=true
# AMSHA_MEMORY_RETENTION_RECALL_RETENTION_DAYS=30
# AMSHA_MEMORY_RETENTION_ARCHIVAL_EVICTION_THRESHOLD=0.3
# AMSHA_MEMORY_RETENTION_ARCHIVAL_MIN_AGE_DAYS=30

# -----------------------------------------------------------------------------
# Self-Evolution (Hermes-Style) — Phase 8-10: disabled by default
# -----------------------------------------------------------------------------
AMSHA_SELF_EVOLVE_ENABLED=false
# AMSHA_SELF_EVOLVE_BACKEND=sqlite
# AMSHA_SELF_EVOLVE_BUFFER_SIZE=50
# AMSHA_SELF_EVOLVE_DEFAULT_SEARCH_LIMIT=8
# AMSHA_SELF_EVOLVE_DIRECTIVES_ENABLED=true
# Synthesis trigger: manual | cron (never "auto" in live path)
# AMSHA_SELF_EVOLVE_SYNTHESIS_TRIGGER=manual
# AMSHA_SELF_EVOLVE_FLUSH_MAX_EVENTS=12
# AMSHA_SELF_EVOLVE_FLUSH_IDLE_MS=300000

# -----------------------------------------------------------------------------
# Security & Governance
# -----------------------------------------------------------------------------
# Session Budget Limit (Prevents runaway costs, essential for free tier tracking)
AMSHA_BUDGET_LIMIT=999.0
AMSHA_BUDGET_ACTION=READONLY  # [BLOCK, READONLY]

# Maximum number of nested agent delegations allowed per session.
# Prevents infinite loops (e.g., Coordinator -> Architect -> Architect).
# Default 3 allows: coordinator → researcher → coder → researcher (for API research).
AMSHA_DELEGATION_MAX_DEPTH=3

# Tools that bypass HITL approval in SUPERVISED mode (comma-separated).
# garuda is NOT in the default list — role trust handles delegation governance.
# Default: schedule_task,manage_schedule
AMSHA_HITL_EXEMPT_TOOLS=schedule_task,manage_schedule

# Safety TTL for session resumption marks (in seconds). 
# Prevents a crashed resume from permanently locking a session.
# Default to (60 secs) 1 min
# Default: 300 (5 minutes) to accommodate long Playwright/search tasks.
AMSHA_RESUMPTION_STALE_MARK_SECONDS=60
AMSHA_TOOLS_PLAYWRIGHT_RESUMPTION_STALE_MARK_SECONDS=300

# Window for reclaiming stuck/orphaned IN_PROGRESS checkpoints (in minutes).
AMSHA_CHECKPOINT_STALE_CLAIM_MINUTES=2

# Master keys for encryption and audit integrity.
# Generate new ones for production: openssl rand -hex 32
AMSHA_VAULT_PEPPER=changeme-vault-pepper-key-min-32-bytes
AMSHA_AUDIT_HMAC_KEY=changeme-audit-hmac-key-min-32-bytes
AMSHA_API_KEYS_INTERNAL=changeme-api-keys-internal-key-min-32-bytes
AMSHA_API_KEYS_CI=changeme-api-keys-ci-key-min-32-bytes

# Set to true to require Human-in-the-Loop approval for sensitive third-party SkillsJars capabilities
AMSHA_SKILLSJARS_REQUIRE_APPROVAL_FOR_SENSITIVE=true
AMSHA_SKILLS_ADAPTIVE_ENABLED=false
AMSHA_SKILLS_DEFAULT_MAX_ITERATIONS=15

# -----------------------------------------------------------------------------
# External API Keys (Optional)
# -----------------------------------------------------------------------------
# Get one at: https://api-dashboard.search.brave.com/app/keys
# 2500 free calls at: https://serper.dev/dashboard
AMSHA_TOOLS_BRAVE_API_KEY=none
AMSHA_TOOLS_SERPER_API_KEY=none

# GitHub Integration
AMSHA_TOOLS_GITHUB_TOKEN=none
AMSHA_GITHUB_REPOS_PER_PAGE=100

# JSON Salvage max lines
AMSHA_CORE_UTIL_JSON_SALVAGE_MAX_LINES=20

# Tool Playwright setup
AMSHA_TOOLS_PLAYWRIGHT_ENABLED=true
# Set false to run browser in headed mode (useful for debugging navigation issues)
AMSHA_TOOLS_PLAYWRIGHT_HEADLESS=true
# Set to true to skip automatic browser installation (useful for headless/constrained envs)
AMSHA_TOOLS_PLAYWRIGHT_SKIP_INSTALL=false
# Enable Playwright MCP Server mode (connects via @playwright/mcp STDIO, falls back to CLI)
AMSHA_TOOLS_PLAYWRIGHT_MCP_ENABLED=false
# Set to false to show browser window (for debugging)
AMSHA_TOOLS_PLAYWRIGHT_MCP_HEADLESS=true
# Command and args for the Playwright MCP Server
AMSHA_TOOLS_PLAYWRIGHT_MCP_COMMAND=npx
AMSHA_TOOLS_PLAYWRIGHT_MCP_ARGS=@playwright/mcp

# LLM Resilience (Max retries and timeouts)
# Secret auto-seeding into agent vault on session start (dev convenience).
# Set false in production - seed secrets manually via /api/v1/vault.
AMSHA_AUTO_SEED_SECRETS=false

# Toggle for full HTTP request/response logging for LLM providers.
# WARNING: Setting to true will leak API keys/tokens to the application logs.
AMSHA_LLM_LOG_HTTP=false
AMSHA_LLM_MAX_RETRIES=3
AMSHA_LLM_MAX_OUTPUT_TOKENS=8192

# Default timeout for LLM calls. 
# NVIDIA cold-start can take 60-90s on free tier - increase to PT120S if needed.
AMSHA_LLM_TIMEOUT=PT60S

# Schema self-correction retry budget per structured output mode
AMSHA_AGENT_SCHEMA_CORRECTION_MAX_RETRIES_STRICT=4
AMSHA_AGENT_SCHEMA_CORRECTION_MAX_RETRIES_LENIENT=6

# Max retries for LLM rate limits (TPM/RPM) before failing the iteration.
AMSHA_AGENT_MAX_RATELIMIT_RETRIES=3

# Rate limit auto-retry thresholds (seconds)
AMSHA_AGENT_RATE_LIMIT_MAX_AUTO_RETRY_SECONDS=15
AMSHA_AGENT_RATE_LIMIT_DEFAULT_RETRY_SECONDS=10

# Default delay for general rate limit retries
AMSHA_RETRY_DEFAULT_DELAY_MS=30000

# Audit engine idle timeout
AMSHA_AUDIT_IDLE_TIMEOUT_MS=10000

# Max backoff delay for memory compaction
AMSHA_MEMORY_COMPACTION_MAX_BACKOFF_MS=60000

# Timeout (seconds) to wait for in-flight compaction before proceeding with stale state.
# Free-tier models may need 60-90s. Default: 60.
AMSHA_COMPACTION_AWAIT_TIMEOUT_SECONDS=60

AMSHA_LLM_TEMPERATURE=0.1

# PII scanning mode: REDACT_AND_FORWARD | BLOCK_AND_NOTIFY
# AMSHA_PII_MODE=REDACT_AND_FORWARD


# -----------------------------------------------------------------------------
# Telegram Integration
# -----------------------------------------------------------------------------

AMSHA_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmNOPQrsTUVwxyz

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Find your ID: message @userinfobot on Telegram.
AMSHA_TELEGRAM_ALLOWED_USER_IDS=<telegram-user-ids-comma-seperated>


# Comma-separated Telegram usernames (without @) - optional, IDs take priority.
AMSHA_TELEGRAM_ALLOWED_USERS=<telegram-user-name>

# Telegram message length
AMSHA_CHANNEL_TELEGRAM_MAX_LENGTH=4096

# -----------------------------------------------------------------------------
# Scheduling & Timezones
# -----------------------------------------------------------------------------
# The default IANA timezone used for relative time scheduling ("in 5 minutes")
# and prompt rendering. Overridden by user-specific metadata when available.
# Valid values: Asia/Kolkata, America/New_York, UTC, etc.
AMSHA_DEFAULT_TIMEZONE=Asia/Kolkata

# Cron startup delay
AMSHA_CRON_STARTUP_DELAY_MS=5000


# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# OTLP endpoint for traces. Use local Jaeger or managed provider.
# Docker compose: http://otel-collector:4317
# Local Jaeger:   http://localhost:4317
# QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true


# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
# Options: PODMAN (recommended) | NAMESPACE (Linux only) | DIRECT (insecure)
AMSHA_SANDBOX_STRATEGY=PODMAN
AMSHA_SANDBOX_ENABLED=true
AMSHA_SANDBOX_PODMAN_IMAGE=localhost/amsha-tool-runner:latest

# [PODMAN-SPECIFIC] Change to 'bridge' or 'slirp4netns' if 'host' is restricted.
# 'host' is now the default to ensure tools (like GitHub) work out-of-the-box.
AMSHA_SANDBOX_NETWORK=host

# [PODMAN-SPECIFIC] Transport mechanism for passing secrets into the container.
# options: 
#   - tmpfs:  Uses /run/amsha/secrets (Linux production only)
#   - tmpdir: Uses OS temp directory (macOS/Windows/Dev)
#   - <path>: Explicit literal path to use for secret files
# Auto-detects based on OS if unset. Defaults to tmpdir on macOS/Windows.
# AMSHA_SANDBOX_SECRET_TRANSPORT=tmpfs

# [PODMAN-SPECIFIC] The UID:GID to run as inside the container. 65534=nobody.
AMSHA_SANDBOX_USER=sandbox

# Resource Limits
AMSHA_SANDBOX_MEMORY_LIMIT=512m
AMSHA_SANDBOX_CPU_LIMIT=0.5
AMSHA_SANDBOX_MAX_OUTPUT_CHARS=8192

# Container Execution Timeouts (in seconds)
AMSHA_SANDBOX_TIMEOUT_SECONDS=30
AMSHA_SANDBOX_NETWORK_TIMEOUT_SECONDS=60

# Circuit Breaker
# AMSHA_SANDBOX_CB_FAILURE_THRESHOLD=3
# AMSHA_SANDBOX_CB_RESET_TIMEOUT_SECONDS=30

# Paths
# AMSHA_SANDBOX_PODMAN_PATH=podman

# Executable overrides (Optional: overrides PATH discovery for host execution)
# AMSHA_SANDBOX_PYTHON_EXECUTABLE=/usr/bin/python3
# AMSHA_SANDBOX_GO_EXECUTABLE=/opt/homebrew/bin/go
# AMSHA_SANDBOX_JAVA_EXECUTABLE=/opt/homebrew/bin/java


# Fallback to host execution if Podman image is missing or daemon is offline.
# WARNING: Setting this to true reduces security isolation.
AMSHA_SANDBOX_ALLOW_INSECURE_FALLBACK=true

# Direct-host execution for diagnostic skills that cannot work inside the Podman
# sandbox (e.g. JDB attaching to host JVMs). Comma-separated skill names.
# Each listed skill receives the host_exec tool capability at startup.
# host_exec still requires HITL approval on every invocation.
AMSHA_TOOLS_HOST_EXEC_SKILLS=jdb-debugger

# Password for 7z archives. Leave empty to disable.
# AMSHA_7Z_PASS=

# -----------------------------------------------------------------------------
# SonarQube Integration (Optional)
# -----------------------------------------------------------------------------
# SonarQube API token for code analysis.
# Generate at: http://localhost:9000 → My Account → Security → Generate Tokens
# Required permission: "Execute Analysis"
# SONAR_TOKEN=sqp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SonarQube server URL (default: local SonarQube instance)
# SONAR_API_URL=http://localhost:9000
