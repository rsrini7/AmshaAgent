# =============================================================================
# ArcClaw - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your specific values.
# DO NOT commit the real '.env' file to version control.
#
# Quick-start defaults are provided where possible. Required fields are
# marked with [REQUIRED] - the app will not start without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime Profile
# -----------------------------------------------------------------------------
# Quarkus profile: prod | dev | test
QUARKUS_PROFILE=prod


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Directory where ArcClaw stores its SQLite databases and state files.
# Docker:  leave as ./data (volume-mounted at /app/data)
# Windows: use forward slashes or set to C:/Users/<user>/arcclaw-data
ARCCLAW_DATA_DIR=./data

# PostgreSQL backend (uncomment and fill in when using %postgresql profile)
# See arcclaw-app/src/main/resources/application.yaml for switching instructions.
# ARCCLAW_PG_HOST=localhost
# ARCCLAW_PG_PORT=5432
# ARCCLAW_PG_DB=arcclaw
# ARCCLAW_PG_USER=arcclaw
# ARCCLAW_PG_PASSWORD=changeme

# Filesystem backend (uncomment when using %filesystem profile)
# ARCCLAW_FS_DATA_DIR=./data/fs


# -----------------------------------------------------------------------------
# HTTP / CORS
# -----------------------------------------------------------------------------
# Allowed CORS origins. Comma-separated for multiple.
ARCCLAW_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# LLM - Ollama (local, shared by chat + embeddings)
# -----------------------------------------------------------------------------
# Base URL for the local Ollama instance.
# Docker:  http://ollama:11434  (service name on compose network)
# Local:   http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# Chat model loaded into Ollama (used only if switching away from Groq).
# OLLAMA_MODEL=llama3.2:1b


# LLM Providers: groq | gemini | openrouter | ollama | openai | omlx | nvidia | cerebras
ARCCLAW_LLM_PROVIDER=groq
# ARCCLAW_LLM_PROVIDER=gemini
# ARCCLAW_LLM_PROVIDER=openrouter
# ARCCLAW_LLM_PROVIDER=ollama
# ARCCLAW_LLM_PROVIDER=openai
# ARCCLAW_LLM_PROVIDER=omlx
# ARCCLAW_LLM_PROVIDER=nvidia
# ARCCLAW_LLM_PROVIDER=cerebras

# -----------------------------------------------------------------------------
# LLM - Reasoning Model
# -----------------------------------------------------------------------------
# [REQUIRED] API key for the primary reasoning model.
# Used for all agent reasoning (coordinator, researcher, coder, debugger, etc.)

# Groq API Keys
ARCCLAW_LLM_API_KEY=<groq-llm-api-key>

# Gemini API Keys
# ARCCLAW_LLM_API_KEY=<gemini-llm-api-key>

# OpenRouter API Keys
# ARCCLAW_LLM_API_KEY=<openrouter-llm-api-key>
# NVIDIA API Keys
# ARCCLAW_LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cerebras API Keys
# ARCCLAW_LLM_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Groq (Default) ---
# ARCCLAW_LLM_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct
# ARCCLAW_LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Gemini ---
# ARCCLAW_LLM_MODEL_NAME=gemini-flash-latest
# ARCCLAW_LLM_MODEL_NAME=gemini-2.5-flash-lite
# ARCCLAW_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ - not required as we are using native gemini sdk.
# Common Models: gemini-3-flash-preview, gemini-3.1-flash-lite-preview, gemini-3.1-pro-preview, gemini-flash-latest,gemini-flash-lite-latest

# --- OpenRouter (Recommended for free tier) ---
# ARCCLAW_LLM_MODEL_NAME=openrouter/free
# ARCCLAW_LLM_MODEL_NAME=openai/gpt-oss-20b:free
# ARCCLAW_LLM_MODEL_NAME=nvidia/nemotron-nano-9b-v2:free
# ARCCLAW_LLM_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# ARCCLAW_LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional app identification (improves rate limits on free tier)
# ARCCLAW_OPENROUTER_APP_NAME=ArcClaw
# ARCCLAW_OPENROUTER_SITE_URL=https://github.com/rsrini7/arcclaw

# --- NVIDIA (NIMs) ---
# ARCCLAW_LLM_MODEL_NAME=moonshotai/kimi-k2.6
# ARCCLAW_LLM_MODEL_NAME=stepfun-ai/step-3.5-flash
# ARCCLAW_LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Cerebras ---
# ARCCLAW_LLM_MODEL_NAME=llama3.1-8b
# ARCCLAW_LLM_MODEL_NAME=qwen-3-235b-a22b-instruct-2507
# ARCCLAW_LLM_BASE_URL=https://api.cerebras.ai/v1

# --- omlx / Local OpenAI-compatible (MLX-based) ---
# Run: mlx_lm.server --model mlx-community/<model> --port 8000
# Uses the openai provider under the hood.
# ARCCLAW_LLM_MODEL_NAME=mlx-community/Qwen3.6-35B-A3B-4bit
# ARCCLAW_LLM_BASE_URL=http://127.0.0.1:8000/v1
# ARCCLAW_LLM_API_KEY=not-needed
# ARCCLAW_LLM_CONTEXT_WINDOW=32768

# Manually force 'Compact Prompt Mode' (condensed security and architectural rules).
# Defaults to true if ARCCLAW_LLM_CONTEXT_WINDOW <= 8192.
# ARCCLAW_LLM_COMPACT_PROMPT_ENABLED=false

# Strategy for ensuring structured output (JSON schema compliance).
# Modes: NATIVE (default), PROMPT_DIRECTIVE (forced JSON-only instructions), LENIENT.
# Auto-set by bootstrap: PROMPT_DIRECTIVE for llama-4-scout, NATIVE for others.
# ARCCLAW_LLM_STRUCTURED_OUTPUT_MODE=NATIVE
# ARCCLAW_INTENT_CLASSIFIER_STRUCTURED_OUTPUT_MODE=NATIVE
# ARCCLAW_COMPACTION_STRUCTURED_OUTPUT_MODE=NATIVE
# ARCCLAW_LLM_FALLBACK_STRUCTURED_OUTPUT_MODE=NATIVE

# Context window size (in tokens). 
# Triggered 'Compact Prompt Mode' if <= 8192 to fit within small windows.
# Auto-set by bootstrap: 8192 (Cerebras-Llama/Ollama), 64k (Cerebras-Qwen), 1M (Gemini), 128k (Others)
# ARCCLAW_LLM_CONTEXT_WINDOW=128000
# ARCCLAW_LLM_CONTEXT_WINDOW=1000000
# ARCCLAW_LLM_CONTEXT_WINDOW=8192


# -----------------------------------------------------------------------------
# LLM - Utility Models (Compaction & Intent Classification)
# -----------------------------------------------------------------------------
# Compaction model (for chat memory summarization)
# Default (Groq)
ARCCLAW_COMPACTION_PROVIDER=groq
ARCCLAW_COMPACTION_MODEL=llama-3.1-8b-instant
ARCCLAW_COMPACTION_BASE_URL=https://api.groq.com/openai/v1
ARCCLAW_COMPACTION_API_KEY=<compaction-qroq-api-key>

# Cerebras Compaction
# ARCCLAW_COMPACTION_PROVIDER=cerebras
# ARCCLAW_COMPACTION_MODEL=llama3.1-8b
# ARCCLAW_COMPACTION_MODEL=qwen-3-235b-a22b-instruct-2507
# ARCCLAW_COMPACTION_BASE_URL=https://api.cerebras.ai/v1
# ARCCLAW_COMPACTION_API_KEY=<compaction-cerebras-api-key>

# OpenRouter Compaction
# ARCCLAW_COMPACTION_PROVIDER=openrouter
# ARCCLAW_COMPACTION_MODEL=openai/gpt-oss-20b:free
# ARCCLAW_COMPACTION_MODEL=google/gemma-3-27b-it:free
# ARCCLAW_COMPACTION_BASE_URL=https://openrouter.ai/api/v1
# ARCCLAW_COMPACTION_API_KEY=<compaction-openrouter-api-key>
# Optional app identification (improves rate limits on free tier)
# ARCCLAW_OPENROUTER_APP_NAME=ArcClaw
# ARCCLAW_OPENROUTER_SITE_URL=https://github.com/rsrini7/arcclaw
# ARCCLAW_COMPACTION_MAX_RETRIES=3

# Intent Classifier model (for tool/agent routing)
# Default (Groq)
ARCCLAW_INTENT_CLASSIFIER_PROVIDER=groq
ARCCLAW_INTENT_CLASSIFIER_MODEL=llama-3.1-8b-instant
ARCCLAW_INTENT_CLASSIFIER_BASE_URL=https://api.groq.com/openai/v1
ARCCLAW_INTENT_CLASSIFIER_API_KEY=<classifier-qroq-api-key>
# ARCCLAW_INTENT_CLASSIFIER_MAX_RETRIES=3

# Cerebras Classifier
# ARCCLAW_INTENT_CLASSIFIER_PROVIDER=cerebras
# ARCCLAW_INTENT_CLASSIFIER_MODEL=llama3.1-8b
# ARCCLAW_INTENT_CLASSIFIER_BASE_URL=https://api.cerebras.ai/v1
# ARCCLAW_INTENT_CLASSIFIER_API_KEY=<classifier-cerebras-api-key>
# ARCCLAW_INTENT_CLASSIFIER_MAX_RETRIES=3

# OpenRouter Classifier
# ARCCLAW_INTENT_CLASSIFIER_PROVIDER=openrouter
# ARCCLAW_INTENT_CLASSIFIER_MODEL=openai/gpt-oss-20b:free
# ARCCLAW_INTENT_CLASSIFIER_BASE_URL=https://openrouter.ai/api/v1
# ARCCLAW_INTENT_CLASSIFIER_API_KEY=<classifier-api-key>
# Optional app identification (improves rate limits on free tier)
# ARCCLAW_OPENROUTER_APP_NAME=ArcClaw
# ARCCLAW_OPENROUTER_SITE_URL=https://github.com/rsrini7/arcclaw
# ARCCLAW_INTENT_CLASSIFIER_MAX_RETRIES=3

# Ollama Classifier
# ARCCLAW_INTENT_CLASSIFIER_OLLAMA_MODEL=llama3.2
# ARCCLAW_INTENT_CLASSIFIER_BASE_URL=http://localhost:11434

# Fallback LLM (used automatically on 429/5xx from primary)

# Preemptively routes to fallback model when conversation history exceeds this length 
# to avoid primary model's safety filters during large batch tool executions.
# ARCCLAW_LLM_FALLBACK_MESSAGE_THRESHOLD=14

# Leave blank to disable.
# ARCCLAW_LLM_FALLBACK_PROVIDER=openrouter
# ARCCLAW_LLM_FALLBACK_MODEL=openai/gpt-oss-20b:free
# ARCCLAW_LLM_FALLBACK_MODEL=openrouter/auto
# ARCCLAW_LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# ARCCLAW_LLM_FALLBACK_API_KEY=<fallback-llm-api-key>

# Optional app identification (improves rate limits on free tier)
# ARCCLAW_OPENROUTER_APP_NAME=ArcClaw
# ARCCLAW_OPENROUTER_SITE_URL=https://github.com/rsrini7/arcclaw


# Alternative Fallback (Ollama - local, no key needed)
# ARCCLAW_LLM_FALLBACK_OLLAMA_BASE_URL=http://localhost:11434
# ARCCLAW_LLM_FALLBACK_OLLAMA_MODEL=llama3.2

# NVIDIA Fallback
# ARCCLAW_LLM_FALLBACK_PROVIDER=nvidia
# ARCCLAW_LLM_FALLBACK_MODEL=mistralai/devstral-2-123b-instruct-2512
# ARCCLAW_LLM_FALLBACK_MODEL=deepseek-ai/deepseek-v3.2
# ARCCLAW_LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
# ARCCLAW_LLM_FALLBACK_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini Fallback
# ARCCLAW_LLM_FALLBACK_PROVIDER=groq
# ARCCLAW_LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# ARCCLAW_LLM_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# ARCCLAW_LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
# ARCCLAW_LLM_FALLBACK_API_KEY=gsk_xxxxxxx
# Cerebras Fallback
# ARCCLAW_LLM_FALLBACK_PROVIDER=cerebras
# ARCCLAW_LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
# ARCCLAW_LLM_FALLBACK_MODEL=qwen-3-235b-a22b-instruct-2507
# ARCCLAW_LLM_FALLBACK_API_KEY=csk-xxxx


# -----------------------------------------------------------------------------
# RAG - Embedding Provider
# -----------------------------------------------------------------------------
# Active embedding provider: ollama | jina | openai
ARCCLAW_EMBED_PROVIDER=jina
ARCCLAW_EMBED_BASE_URL=https://api.jina.ai/v1/
ARCCLAW_EMBED_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ARCCLAW_EMBED_DIMENSIONS=768

# Ollama Example
# ARCCLAW_EMBED_PROVIDER=ollama
# ARCCLAW_EMBED_BASE_URL=http://localhost:11434

# Embedding model name.
#   ollama:  nomic-embed-text:v1.5     (768 dims)
#            mxbai-embed-large          (1024 dims)
#   jina:    auto-set to jina-embeddings-v5-text-nano when ARCCLAW_EMBED_PROVIDER=jina
#   openai:  text-embedding-3-small    (1536 dims)
#            text-embedding-3-large    (3072 dims)
# ARCCLAW_EMBED_MODEL=nomic-embed-text:v1.5


# Vector dimension - MUST match the model above.
# Mismatch causes silent vec_global insert failures.
#   nomic-embed-text:v1.5   → 768
#   mxbai-embed-large       → 1024
#   jina-embeddings-v5-text-small     → 1024
#   jina-embeddings-v5-text-nano      → 768
#   text-embedding-3-small  → 1536
# ARCCLAW_EMBED_DIMENSIONS=768


# -----------------------------------------------------------------------------
# RAG Native Extensions
# -----------------------------------------------------------------------------
# Path where the sqlite-vec extension is extracted from the binary on first boot.
# If you want to keep your root directory clean, point this to your data dir.
# Default: ./lib/vec0 (becomes ./lib/vec0.so or .dll)
# ARCCLAW_RAG_VEC_PATH=./lib/vec0


# -----------------------------------------------------------------------------
# Chat Memory & Retention
# -----------------------------------------------------------------------------
# Maximum messages to keep in the active LLM sliding window.
# ARCCLAW_CHAT_MEMORY_MAX_MESSAGES=20

# Number of days to retain chat history in SQLite.
# After this period, SessionReaper auto-purges old conversations.
ARCCLAW_CHAT_MEMORY_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Security & Governance
# -----------------------------------------------------------------------------
# Session Budget Limit (Prevents runaway costs, essential for free tier tracking)
ARCCLAW_BUDGET_LIMIT=999.0
ARCCLAW_BUDGET_ACTION=READONLY  # [BLOCK, READONLY]

# Maximum number of nested agent delegations allowed per session.
# Prevents infinite loops (e.g., Coordinator -> Architect -> Architect).
ARCCLAW_DELEGATION_MAX_DEPTH=2

# Safety TTL for session resumption marks (in seconds). 
# Prevents a crashed resume from permanently locking a session.
# Default to (60 secs) 1 min
# Default: 300 (5 minutes) to accommodate long Playwright/search tasks.
ARCCLAW_RESUMPTION_STALE_MARK_SECONDS=60
ARCCLAW_PLAYWRIGHT_RESUMPTION_STALE_MARK_SECONDS=300

# Window for reclaiming stuck/orphaned IN_PROGRESS checkpoints (in minutes).
ARCCLAW_CHECKPOINT_STALE_CLAIM_MINUTES=2

# Master keys for encryption and audit integrity.
# Generate new ones for production: openssl rand -hex 32
ARCCLAW_VAULT_PEPPER=changeme-vault-pepper-key-min-32-bytes
ARCCLAW_AUDIT_HMAC_KEY=changeme-audit-hmac-key-min-32-bytes
ARCCLAW_API_KEYS_INTERNAL=changeme-api-keys-internal-key-min-32-bytes
ARCCLAW_API_KEYS_CI=changeme-api-keys-ci-key-min-32-bytes

# -----------------------------------------------------------------------------
# External API Keys (Optional)
# -----------------------------------------------------------------------------
# Get one at: https://api-dashboard.search.brave.com/app/keys
# 2500 free calls at: https://serper.dev/dashboard
ARCCLAW_TOOLS_BRAVE_API_KEY=none
ARCCLAW_TOOLS_SERPER_API_KEY=none

# GitHub Integration
ARCCLAW_TOOLS_GITHUB_TOKEN=none
ARCCLAW_GITHUB_REPOS_PER_PAGE=100

# JSON Salvage max lines
ARCCLAW_CORE_UTIL_JSON_SALVAGE_MAX_LINES=20

# Tool Playwright setup
ARCCLAW_TOOLS_PLAYWRIGHT_ENABLED=true
# Set false to run browser in headed mode (useful for debugging navigation issues)
ARCCLAW_TOOLS_PLAYWRIGHT_HEADLESS=true
# Set to true to skip automatic browser installation (useful for headless/constrained envs)
ARCCLAW_PLAYWRIGHT_SKIP_INSTALL=false

# LLM Resilience (Max retries and timeouts)
# Secret auto-seeding into agent vault on session start (dev convenience).
# Set false in production - seed secrets manually via /api/v1/vault.
ARCCLAW_AUTO_SEED_SECRETS=false

# Toggle for full HTTP request/response logging for LLM providers.
# WARNING: Setting to true will leak API keys/tokens to the application logs.
ARCCLAW_LLM_LOG_HTTP=false
ARCCLAW_LLM_MAX_RETRIES=3
ARCCLAW_LLM_MAX_OUTPUT_TOKENS=8192

# Default timeout for LLM calls. 
# NVIDIA cold-start can take 60-90s on free tier - increase to PT120S if needed.
ARCCLAW_LLM_TIMEOUT=PT60S

# Schema self-correction retry budget per structured output mode
ARCCLAW_AGENT_SCHEMA_CORRECTION_MAX_RETRIES_STRICT=4
ARCCLAW_AGENT_SCHEMA_CORRECTION_MAX_RETRIES_LENIENT=6

# Max retries for LLM rate limits (TPM/RPM) before failing the iteration.
ARCCLAW_AGENT_MAX_RATELIMIT_RETRIES=3

# Rate limit auto-retry thresholds (seconds)
ARCCLAW_AGENT_RATE_LIMIT_MAX_AUTO_RETRY_SECONDS=15
ARCCLAW_AGENT_RATE_LIMIT_DEFAULT_RETRY_SECONDS=10

# Default delay for general rate limit retries
ARCCLAW_RETRY_DEFAULT_DELAY_MS=30000

# Audit engine idle timeout
ARCCLAW_AUDIT_IDLE_TIMEOUT_MS=10000

# Max backoff delay for memory compaction
ARCCLAW_MEMORY_COMPACTION_MAX_BACKOFF_MS=60000

ARCCLAW_LLM_TEMPERATURE=0.1

# PII scanning mode: REDACT_AND_FORWARD | BLOCK_AND_NOTIFY
# ARCCLAW_PII_MODE=BLOCK_AND_NOTIFY


# -----------------------------------------------------------------------------
# Telegram Integration
# -----------------------------------------------------------------------------

ARCCLAW_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmNOPQrsTUVwxyz

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Find your ID: message @userinfobot on Telegram.
ARCCLAW_TELEGRAM_ALLOWED_USER_IDS=<telegram-user-ids-comma-seperated>


# Comma-separated Telegram usernames (without @) - optional, IDs take priority.
ARCCLAW_TELEGRAM_ALLOWED_USERS=<telegram-user-name>

# Telegram message length
ARCCLAW_CHANNEL_TELEGRAM_MAX_LENGTH=4096

# -----------------------------------------------------------------------------
# Scheduling & Timezones
# -----------------------------------------------------------------------------
# The default IANA timezone used for relative time scheduling ("in 5 minutes")
# and prompt rendering. Overridden by user-specific metadata when available.
# Valid values: Asia/Kolkata, America/New_York, UTC, etc.
ARCCLAW_DEFAULT_TIMEZONE=Asia/Kolkata

# Cron startup delay
ARCCLAW_CRON_STARTUP_DELAY_MS=5000


# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# OTLP endpoint for traces. Use local Jaeger or managed provider.
# Docker compose: http://otel-collector:4317
# Local Jaeger:   http://localhost:4317
# QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true


# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
# Options: PODMAN (recommended) | NAMESPACE (Linux only) | DIRECT (insecure)
ARCCLAW_SANDBOX_STRATEGY=PODMAN
ARCCLAW_SANDBOX_ENABLED=true
ARCCLAW_SANDBOX_PODMAN_IMAGE=localhost/arcclaw-tool-runner:latest

# [PODMAN-SPECIFIC] Change to 'bridge' or 'slirp4netns' if 'host' is restricted.
# 'host' is now the default to ensure tools (like GitHub) work out-of-the-box.
ARCCLAW_SANDBOX_NETWORK=host

# [PODMAN-SPECIFIC] Transport mechanism for passing secrets into the container.
# options: 
#   - tmpfs:  Uses /run/arcclaw/secrets (Linux production only)
#   - tmpdir: Uses OS temp directory (macOS/Windows/Dev)
#   - <path>: Explicit literal path to use for secret files
# Auto-detects based on OS if unset. Defaults to tmpdir on macOS/Windows.
# ARCCLAW_SANDBOX_SECRET_TRANSPORT=tmpfs

# [PODMAN-SPECIFIC] The UID:GID to run as inside the container. 65534=nobody.
ARCCLAW_SANDBOX_USER=sandbox

# Resource Limits
ARCCLAW_SANDBOX_MEMORY_LIMIT=512m
ARCCLAW_SANDBOX_CPU_LIMIT=0.5
ARCCLAW_SANDBOX_MAX_OUTPUT_CHARS=8192

# Container Execution Timeouts (in seconds)
ARCCLAW_SANDBOX_TIMEOUT_SECONDS=30
ARCCLAW_SANDBOX_NETWORK_TIMEOUT_SECONDS=60

# Paths
# ARCCLAW_SANDBOX_PODMAN_PATH=podman

# Executable overrides (Optional: overrides PATH discovery for host execution)
# ARCCLAW_SANDBOX_PYTHON_EXECUTABLE=/usr/bin/python3
# ARCCLAW_SANDBOX_GO_EXECUTABLE=/opt/homebrew/bin/go
# ARCCLAW_SANDBOX_JAVA_EXECUTABLE=/opt/homebrew/bin/java

# Fallback to host execution if Podman image is missing or daemon is offline.
# WARNING: Setting this to true reduces security isolation.
ARCCLAW_SANDBOX_ALLOW_INSECURE_FALLBACK=true

