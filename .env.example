AMSHA_COMPACTION_CLAUDE_CODE_MODEL=claude-sonnet-4-5
AMSHA_COMPACTION_CLAUDE_CODE_BASE_URL=https://api.anthropic.com

# --- Antigravity Compaction (uncomment to use) ---
