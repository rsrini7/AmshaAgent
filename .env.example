AMSHA_COMPACTION_AGY_MODEL=gemini-3.1-flash-lite
AMSHA_COMPACTION_AGY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Kimchi Compaction (uncomment to use) ---
