# =============================================================================
# ARC CLAW - Environment Configuration Template
# Copy this file to '.env' and fill in your specific values.
# DO NOT commit the real '.env' file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Settings
# -----------------------------------------------------------------------------
# Determines the behavior of Quarkus (dev, test, prod)
QUARKUS_PROFILE=prod

# Directory where ArcClaw will store its internal databases and states
ARCCLAW_DATA_DIR=./data

# CORS allowed origins (comma-separated for multiple, e.g. http://localhost:3000,https://app.example.com)
ARCCLAW_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# LangChain4J & AI Models
# -----------------------------------------------------------------------------
# Base URL if hosting Ollama locally or in your network
OLLAMA_BASE_URL=http://localhost:11434

# The specific model ID to initialize for the system.
OLLAMA_MODEL=llama3.2:1b

# -----------------------------------------------------------------------------
# Tool Secrets (Vault)
# -----------------------------------------------------------------------------
# GitHub token for the Agent repository operations tools
GITHUB_TOKEN=ghp_your_github_token_here

# Groq Cloud API Key (for llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
# Point to your local OTel Collector or managed Jaeger instance
QUARKUS_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317


# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklmNOPQrsTUVwxyz
