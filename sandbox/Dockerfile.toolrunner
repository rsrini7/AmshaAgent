# sandbox/Dockerfile.toolrunner
# Amsha Agent secure tool-runner sandbox image.
# Build: podman build --no-cache -t amsha-tool-runner -f ./sandbox/Dockerfile.toolrunner .
FROM alpine:3.21

# ── System base - tiny, never changes ────────────────────────────────────────
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    curl \
    git \
    bash

# ── Java - full JDK (needed for java --source in-container compilation) ──────
# openjdk21 is the latest LTS available on Alpine 3.21.
# openjdk25 is not yet packaged for Alpine stable - edge is too unstable for sandbox.
# Full JDK ~300MB vs ~100MB for JRE-headless. Needed for java --source mode
# which compiles & runs in a single step inside the container (see H4).
RUN apk add --no-cache openjdk21

# ── Go - second heaviest, version bumps quarterly ────────────────────────────
# CGO_ENABLED=0: pure Go mode - skips GCC/binutils/libstdc++ toolchain (~150MB saved).
# LLM-generated Go code never uses CGo. GOFLAGS=-mod=mod allows go run without go.sum.
RUN apk add --no-cache go
ENV CGO_ENABLED=0 \
    GOFLAGS="-mod=mod" \
    GOMAXPROCS=1

# ── Node.js (~80MB) ───────────────────────────────────────────────────────────
RUN apk add --no-cache nodejs npm

# ── Python 3 ──────────────────────────────────────────────────────────────────
# py3-pip included - LLM-generated code may require pip install at runtime.
# Remove py3-pip if sandbox policy disallows runtime package installation.
RUN apk add --no-cache python3 py3-pip

# ── GitHub CLI - changes most frequently of all tooling ──────────────────────
RUN apk add --no-cache github-cli

# ── Python runtime hygiene ────────────────────────────────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── Security hardening ────────────────────────────────────────────────────────
# Run as a non-root user - LLM-generated code must never run as root.
# Must come AFTER all apk installs (root required to install packages).
RUN addgroup -S sandbox && adduser -S sandbox -G sandbox
USER sandbox

# ── Workspace ─────────────────────────────────────────────────────────────────
WORKDIR /workspace

# ── Smoke-test all runtimes at build time ─────────────────────────────────────
# Build fails fast if any runtime is broken/missing - catch it at image build,
# not at first user execution.
RUN go version && \
    python3 --version && \
    node --version && \
    java -version && \
    bash --version && \
    gh --version