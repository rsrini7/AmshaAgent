### Create a new Workspace Session
# @name createSession
POST http://localhost:8080/api/v1/sessions
Content-Type: application/json


###

### Run the Grok Agent (Asynchronous)
# Requires the sessionId from the createSession request
POST http://localhost:8080/api/v1/sessions/{{createSession.response.body.sessionId}}/run-async
Content-Type: application/json

{
    "goal": "Analyze the openclaw repository on github and tell me what it does",
    "agentRole": "grok",
    "maxIterations": 5
}

###

### Check the Agent's Execution Status
# Requires the sessionId from the createSession request
GET http://localhost:8080/api/v1/sessions/{{createSession.response.body.sessionId}}/status/grok

###

### (Optional) Run the Agent Synchronously (Blocking)
# This will block the HTTP request until the agent finishes (or hits maxIterations)
POST http://localhost:8080/api/v1/sessions/{{createSession.response.body.sessionId}}/run
Content-Type: application/json

{
    "goal": "Analyze the arcclaw repository statistics",
    "agentRole": "grok"
}
