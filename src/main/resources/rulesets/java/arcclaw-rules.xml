<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="ArcClaw Code Size Gate"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Enforces maximum boundaries for class and method structures on JDK 25.
    Only NcssCount is active. All other PMD rules are excluded to avoid noise.</description>

    <exclude-pattern>.*/module-info\.java</exclude-pattern>

    <!-- Explicitly include ONLY NcssCount. All other rules from the same category
         are excluded by not referencing the category at all. -->
    <rule name="NcssTypeCount"
          class="net.sourceforge.pmd.lang.java.rule.design.NcssCountRule"
          message="Type has too many NCSS lines (found {0}, max 500)"
          externalInfoUrl="https://docs.pmd-code.org/pmd_rules_java_design.html#ncsscount">
        <properties>
            <property name="typeReportLevel" value="500"/>
        </properties>
    </rule>

    <rule name="NcssMethodCount"
          class="net.sourceforge.pmd.lang.java.rule.design.NcssCountRule"
          message="Method has too many NCSS lines (found {0}, max 80)"
          externalInfoUrl="https://docs.pmd-code.org/pmd_rules_java_design.html#ncsscount">
        <properties>
            <property name="methodReportLevel" value="80"/>
        </properties>
    </rule>

</ruleset>
