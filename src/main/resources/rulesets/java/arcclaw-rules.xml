<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="ArcClaw Code Size Gate"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Enforces maximum boundaries for class and method structures on JDK 25.
    NcssCount measures non-commenting source statements for methods (80 NCSS).
    ExcessiveClassLength is a custom XPath rule enforcing 500 total lines per class.</description>

    <exclude-pattern>.*/module-info\.java</exclude-pattern>

    <!-- Method length: max 80 NCSS lines. classReportLevel disabled (handled by ExcessiveClassLength). -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="classReportLevel" value="10000"/>
            <property name="methodReportLevel" value="80"/>
        </properties>
    </rule>

    <!-- Cognitive complexity: max 50 (PMD 7.x). Require refactoring and then adjust later. -->
    <rule ref="category/java/design.xml/CognitiveComplexity">
        <properties>
            <property name="reportLevel" value="50"/>
        </properties>
    </rule>

    <!-- Total class length: max 500 lines (including blanks, comments).
         Uses ClassBody span since ClassDeclaration only covers the declaration line in PMD 7.x. -->
    <rule name="ExcessiveClassLength"
          language="java"
          message="Class {0} exceeds 500 lines. Split into smaller classes."
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>Enforces a maximum of 500 total lines per class (including blank lines and comments).
        Uses ClassBody/@EndLine - ClassBody/@BeginLine to measure the full class span.</description>
        <priority>2</priority>
        <properties>
            <property name="xpath">
                <value>
<![CDATA[
//ClassDeclaration[ClassBody/@EndLine - ClassBody/@BeginLine > 500]
]]>
                </value>
            </property>
        </properties>
    </rule>

</ruleset>
