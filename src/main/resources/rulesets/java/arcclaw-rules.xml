<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="ArcClaw Code Size Gate"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Enforces maximum boundaries for class and method structures on JDK 25.
    NcssCount for method/type size. ExcessiveLength for file size.
    PMD loads entire categories when referencing individual rules — violations from
    unrelated rules in those categories are expected noise. SonarQube is the real gate.</description>

    <exclude-pattern>.*/module-info\.java</exclude-pattern>

    <!-- Method length: max 80 NCSS lines. Type length: max 500 NCSS lines. -->
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="typeReportLevel" value="500"/>
            <property name="methodReportLevel" value="80"/>
        </properties>
    </rule>

    <!-- File length: max 500 lines -->
    <rule ref="category/java/design.xml/ExcessiveLength">
        <properties>
            <property name="minimum" value="500"/>
        </properties>
    </rule>

</ruleset>
