<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.amsha</groupId>
    <artifactId>amsha-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>amsha-self-evolve</artifactId>
  <name>amsha-self-evolve</name>
  <description>Self-Evolution trace capture, extraction, and directive synthesis</description>

  <dependencies>
    <!-- Core — for config, workspace context, CDI -->
    <dependency>
      <groupId>com.amsha</groupId>
      <artifactId>amsha-core</artifactId>
    </dependency>

    <!-- Persistence API — for store ports -->
    <dependency>
      <groupId>com.amsha</groupId>
      <artifactId>amsha-persistence-api</artifactId>
    </dependency>

    <!-- Quarkus CDI -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-arc</artifactId>
    </dependency>

    <!-- JDBI -->
    <dependency>
      <groupId>io.quarkiverse.jdbi</groupId>
      <artifactId>quarkus-jdbi</artifactId>
    </dependency>

    <!-- JBoss Logging -->
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
    </dependency>

    <!-- LangChain4j for LLM-based directive synthesis -->
    <dependency>
      <groupId>io.quarkiverse.langchain4j</groupId>
      <artifactId>quarkus-langchain4j-core</artifactId>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5-mockito</artifactId>
      <scope>test</scope>
    </dependency>

          <!-- Security vocabulary (vault interface, tool operation, autonomy) -->
          <dependency>
              <groupId>com.amsha</groupId>
              <artifactId>amsha-security-api</artifactId>
              <version>${project.version}</version>
          </dependency>
          <!-- Tool authoring contracts -->
          <dependency>
              <groupId>com.amsha</groupId>
              <artifactId>amsha-tool-api</artifactId>
              <version>${project.version}</version>
          </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals><goal>jandex</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
