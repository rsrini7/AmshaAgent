  <build>
    <plugins>
      <!-- GraalVM cannot read skill resources from dependency JARs at runtime.
           Materialize all SkillsJar resources in the application output first. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>unpack-skillsjar-resources</id>
            <phase>process-resources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeGroupIds>com.skillsjars</includeGroupIds>
              <includes>META-INF/skills/**</includes>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <overWriteIfNewer>true</overWriteIfNewer>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
            <!-- Netty requires sun.misc.Unsafe Memory Access which is restricted default in JDK 22/25 (JEP 471) -->
            <!-- JBoss Threads requires java.lang opens for thread-local-reset in JDK 24+ -->
            <!-- ByteBuddy requires experimental flag for JDK 25 bytecode proxy generation -->
            <jvmArgs>--add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dnet.bytebuddy.experimental=true --enable-native-access=ALL-UNNAMED</jvmArgs>
            <warnIfBuildGoalMissing>false</warnIfBuildGoalMissing>
            <debug>false</debug>        <!-- disables JDWP in quarkus:dev -->
            <!-- OR keep debug but force suspend=n explicitly: -->
            <!-- <debugHost>localhost</debugHost> -->
            <!-- <suspend>false</suspend> -->
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.smallrye</groupId>
        <artifactId>jandex-maven-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <id>make-index</id>
            <goals>
              <goal>jandex</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.5</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <systemPropertyVariables>
                <native.image.path>
                  ${project.build.directory}/${project.build.finalName}-runner
                </native.image.path>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>bake-build-backend</id>
            <phase>process-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <echo file="${project.build.outputDirectory}/build-info.properties"
                      message="quarkus.amsha.build.backend=${amsha.build.backend}${line.separator}"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>sync-env-example</id>
            <phase>generate-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <copy file="${project.basedir}/../.env.example"
                      tofile="${project.basedir}/src/main/resources/env-example"
                      overwrite="true"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>copy-ui-assets</id>
            <phase>process-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy todir="${project.build.outputDirectory}/META-INF/resources">
                  <fileset dir="${project.parent.basedir}/ui/dist" erroronmissingdir="false"/>
                </copy>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>ensure-openapi-yaml</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <echo file="${project.build.directory}/openapi.yaml" append="false">openapi: 3.0.3
info:
  title: Amsha Agent API
  version: 0.1.0
paths: {}</echo>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <target>
                <exec executable="python3" failonerror="true">
                  <arg value="${maven.multiModuleProjectDirectory}/scripts/verify_jacoco_coverage.py"/>
                  <arg value="--minimum"/>
                  <arg value="${jacoco.minimum.line.coverage}"/>
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>ts-dto</id>
      <activation>
        <property><name>ts-dto</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openapitools</groupId>
            <artifactId>openapi-generator-maven-plugin</artifactId>
            <version>7.11.0</version>
            <executions>
              <execution>
                <id>generate-ts-dto</id>
                <phase>package</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <inputSpec>${project.basedir}/target/openapi.yaml</inputSpec>
                  <generatorName>typescript-fetch</generatorName>
                  <output>${project.basedir}/../ui/src/api/generated</output>
                  <configOptions>
                    <modelPropertyNaming>original</modelPropertyNaming>
                    <supportsES6>true</supportsES6>
                    <typescriptThreePlus>true</typescriptThreePlus>
                  </configOptions>
                  <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>native</id>
      <activation>
        <property><name>native</name></property>
      </activation>
      <properties>
        <skipITs>false</skipITs>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <quarkus.native.container-build>true</quarkus.native.container-build>
        <quarkus.native.container-runtime>podman</quarkus.native.container-runtime>
        <quarkus.native.builder-image>
          quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-25
        </quarkus.native.builder-image>
        <quarkus.native.additional-build-args>-H:+ReportExceptionStackTraces</quarkus.native.additional-build-args>
        <quarkus.native.resources.includes>
          native/vec0/*,
          templates/**,
          prompts/**,
          skills/**,
          META-INF/skills/**,
          META-INF/services/**,
          provider-catalog.json
        </quarkus.native.resources.includes>
      </properties>
    </profile>

    <!-- Simplified Slim Profile: Uses automatic OS detection from parent POM -->
    <profile>
      <id>jvm</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties>
        <quarkus.package.jar.type>fast-jar</quarkus.package.jar.type>
        <quarkus.package.jar.enabled>true</quarkus.package.jar.enabled>
      </properties>
    </profile>
  </profiles>
