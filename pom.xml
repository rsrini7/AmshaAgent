    <jacoco.version>0.8.15</jacoco.version>
    <!-- Ratchet, not a fixed floor. Measured reactor line coverage is >83.9%
         ratcheted to 0.82 per user instruction and TEST_COVERAGE_ANALYSIS.md §10. -->
    <jacoco.minimum.line.coverage>0.82</jacoco.minimum.line.coverage>
    <!-- Test hang guardrails. The reactor's slowest test is ~10 s and its slowest module (`app`)
         spends ~2.6 min in tests, so both ceilings leave an order of magnitude of headroom. They
         exist to turn an *infinite* hang into a visible failure, not to police test speed.

         NOTE: the JUnit Platform's own duration syntax is `<number> [ns|us|ms|s|m|h|d]` - it does
         NOT accept ISO-8601. `PT5M` is rejected and the timeout is then silently ignored, which
         makes the guard inert. Keep the space between number and unit. -->
    <tests.timeout.default>5 m</tests.timeout.default>
    <tests.forked.process.timeout.seconds>900</tests.forked.process.timeout.seconds>
    <bytebuddy.version>1.18.8</bytebuddy.version>
    <maven.surefire.argLine>-javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar --add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/sun.nio.ch=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED -Dnet.bytebuddy.experimental=true --enable-native-access=ALL-UNNAMED -XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true -XX:+StartAttachListener</maven.surefire.argLine>
