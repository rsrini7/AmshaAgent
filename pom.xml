<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.arcclaw</groupId>
  <artifactId>arcclaw-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>arcclaw-channel-api</module>
    <module>arcclaw-core</module>
    <module>arcclaw-mcp</module>
    <module>arcclaw-onboarding</module>
    <module>arcclaw-rag</module>
    <module>arcclaw-deployment</module>
    <module>arcclaw-channel-telegram</module>
    <module>arcclaw-channel-web</module>
    <module>arcclaw-app</module>
    <module>arcclaw-ui</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.version>3.27.2</quarkus.version>
    <bouncycastle.version>1.83</bouncycastle.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <quarkus.config.build-time-config-sources>false</quarkus.config.build-time-config-sources>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-langchain4j-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-camel-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-channel-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-deployment</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-mcp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-channel-telegram</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-channel-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-rag</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.arcclaw</groupId>
        <artifactId>arcclaw-onboarding</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>1.4.1</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus.platform</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.version}</version>
          <extensions>true</extensions>
          <executions>
              <execution>
                  <goals>
                      <goal>build</goal>
                      <goal>generate-code</goal>
                      <goal>generate-code-tests</goal>
                  </goals>
              </execution>
          </executions>
          <configuration>
              <!-- Netty requires sun.misc.Unsafe Memory Access which is restricted default in JDK 22/25 (JEP 471) -->
              <!-- JBoss Threads requires java.lang opens for thread-local-reset in JDK 24+ -->
              <!-- ByteBuddy requires experimental flag for JDK 25 bytecode proxy generation -->
              <!-- -Dsmallrye.config.locations=file:${project.basedir}/../.env -->
              <jvmArgs>--add-opens java.base/java.nio=ALL-UNNAMED --add-opens java.base/jdk.internal.misc=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow -Dnet.bytebuddy.experimental=true --enable-native-access=ALL-UNNAMED</jvmArgs>
              <warnIfBuildGoalMissing>false</warnIfBuildGoalMissing>
              <debug>false</debug>        <!-- disables JDWP in quarkus:dev -->
              <!-- OR keep debug but force suspend=n explicitly: -->
              <!-- <debugHost>localhost</debugHost> -->
              <!-- <suspend>false</suspend> -->
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.15.0</version>
          <configuration>
            <source>25</source>
            <target>25</target>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.5</version>
          <configuration>
            <argLine>--add-opens=java.base/java.lang=ALL-UNNAMED -Dnet.bytebuddy.experimental=true -Djdk.net.URLClassPath.disableClassPathURLCheck=true --sun-misc-unsafe-memory-access=allow --enable-native-access=ALL-UNNAMED</argLine>
            <!-- Kill the forked JVM immediately after System.exit instead of waiting 30s -->
            <shutdown>kill</shutdown>
            <!-- Ensure each test module gets a fresh JVM -->
            <forkCount>1</forkCount>
            <reuseForks>true</reuseForks>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
